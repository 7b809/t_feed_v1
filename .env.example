# .env.example
#
# Copy to .env and fill in the values you actually need.
# No access token of any kind is used by this project — Upstox is called
# anonymously for candle data.

APP_NAME=mega_archive_service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- MongoDB (Job 1) ----------
MONGO_URL=
MONGO_DATABASE=UPSTOX_APP_V2
MONGO_COLLECTION=app_tokens
MONGO_DOCUMENT_ID=backup_candles
MONGO_DOCUMENT_ID_TYPE=string
MONGO_QUERY_JSON={"project":"candle-backup"}

# ---------- MEGA (Job 1) ----------
MEGA_DESTINATION_DIR=./storage/mega
MEGA_DOWNLOAD_DIR=./storage/downloads
MEGA_ARCHIVE_FILENAME=data.zip

# ---------- Cleanup ----------
# Comma-separated list of folders deleted BEFORE startup, scheduled
# refresh, and manual hard-refresh. Leave empty to disable.
# Default wipes the entire storage tree (downloads + extraction).
CLEANUP_DIRS=storage,data

# ---------- Scheduler ----------
SCHEDULER_ENABLED=true
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
SCHEDULE_WEEKDAYS=mon-fri
REFRESH_ON_STARTUP=true

# ---------- API ----------
API_KEY=

# ---------- Limits ----------
MAX_ARCHIVE_SIZE_MB=2048
MAX_EXTRACTED_SIZE_MB=10240
MAX_ARCHIVE_FILES=100000
MONGO_TIMEOUT_MS=5000
REFRESH_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0

# ---------- Job 2: EMA ----------
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_CANDLE_COUNT=3000
EMA_HISTORY_DAYS=10
EMA_MAX_WORKERS=5

# Cycle length in seconds. Cycles run 24/7 from boot (not just during
# market hours) so heartbeats flow even when the market is closed.
# The "no Upstox API call before 09:16:10" rule is enforced per-instrument
# inside the cycle, not at the cycle level.
EMA_POLL_SECONDS=60

# Emit a cycle heartbeat every N cycles (1 = every cycle).
EMA_HEARTBEAT_CYCLES=1

# Throttle the "Cycle N complete" line in the COMBINED log file only.
# Per-module log and console still print every cycle.
EMA_CYCLE_LOG_EVERY=100

# Timeout around each synchronous Upstox intraday_1m() call.
EMA_FETCH_TIMEOUT_SECONDS=30

EMA_INDEX_INSTRUMENTS=NSE_INDEX|Nifty 50,BSE_INDEX|SENSEX
EMA_INSTRUMENTS_FILE=./storage/mega/all_instruments.json

# ---------- Telegram Notifications ----------
# Rich HTML notifications for startup / shutdown / refresh / exceptions /
# EMA bootstrap events. Fully best-effort: a Telegram outage never
# affects the app. Create a bot with @BotFather; find your chat id via
# @userinfobot (or by calling https://api.telegram.org/bot<TOKEN>/getUpdates
# after sending any message to your bot).
#
# If TELEGRAM_ENABLED=true but BOT_TOKEN or CHAT_ID is empty, the notifier
# silently disables itself — no startup error.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Logging ----------
LOG_LEVEL=INFO
LOGS_DIR=./logs