# .env.example

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=UPSTOX_APP_V2

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# New-isolation announcements go ONLY to this official group (separate from TELEGRAM_CHAT_ID).
TELEGRAM_GROUP_ENABLED=true
TELEGRAM_GROUP_CHAT_ID=
# Base URL for instrument charts included in isolation/Supertrend Telegram messages.
CHART_BASE_URL=https://ng7.up.railway.app

# Daily MEGA backup (archives DATA_DIR; staging directory must be outside DATA_DIR)
DATA_DIR=./data
DAILY_DATA_BACKUP_ENABLED=true
DAILY_DATA_BACKUP_DIR=./backups
DAILY_DATA_BACKUP_HOUR=16
DAILY_DATA_BACKUP_MINUTE=5
DAILY_DATA_BACKUP_DAYS=mon-fri
DAILY_DATA_BACKUP_COLLECTION=daily_data_backup_state
# Remove DATA_DIR contents only after MEGA upload verification succeeds.
DAILY_DATA_BACKUP_CLEANUP_ENABLED=true

MEGA_ENABLED=true
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_BACKUP_ROOT=isolation_app

# Isolation Supertrend feed capture
ISOLATED_DATA_DIR=data/isolated

# Calculate independent completed-candle pivot levels for isolated + opposite legs only.
ISOLATED_PIVOT_ENABLED=true
ISOLATED_PIVOT_INTERVALS=1,15
ISOLATED_PIVOT_SCHEDULER_INTERVAL_SECONDS=30
ISOLATED_PIVOT_CANDLE_CLOSE_GRACE_SECONDS=5
ISOLATED_PIVOT_FETCH_REQUESTS_PER_SECOND=4
ISOLATED_PIVOT_FETCH_MAX_RETRIES=2
ISOLATED_PIVOT_FETCH_RETRY_BACKOFF_SECONDS=1
EMA_WS_BASE_URL=wss://ema.novag7.in
ISOLATED_SUPERTREND_ENABLED=true
SUPERTREND_INTERVALS=1m,15m
ISOLATED_WS_MAX_BACKOFF_SECONDS=30
REQUIRE_TODAY_ONLY_SCOPE=true
# First confirmed Supertrend signal analysis; sandbox-only, no orders are placed.
SANDBOX_SUPERTREND_SIGNALS_ENABLED=true

# Upstox
UPSTOX_API_VERSION=2.0
UPSTOX_SEARCH_URL=https://api.upstox.com/v2/instruments/search

# Feed
FEED_MODE=full
LOG_RAW_FEED=false
FEED_HEALTH_INTERVAL_SECONDS=300
FEED_STALE_AFTER_SECONDS=120

# Index priority
STRATEGY_INDEX_PRIORITY=NSE_INDEX|NIFTY MID SELECT,NSE_INDEX|Nifty Bank,NSE_INDEX|Nifty 50,BSE_INDEX|SENSEX

# Bias fallback (used only if NIFTY trend is NEUTRAL)
STRATEGY_RELATIONAL_R3_BIAS=CE
STRATEGY_RELATIONAL_S3_BIAS=PE

# Bias source: nifty_trend | trigger_side
ISOLATION_BIAS_SOURCE=nifty_trend

# Isolation execution-mode thresholds (§6.1)
ISOLATION_MODE_CUTOFF_HOUR=10
ISOLATION_MODE_CUTOFF_MINUTE=30
ISOLATION_MODE_PRICE_HIGH=250
ISOLATION_MODE_PRICE_LOW=100

# NIFTY option search
#
# NIFTY_SEARCH_EXPIRY is the PRIMARY expiry keyword the search service
# tries first. On expiry day, or after the provider has rolled the
# weekly contract, `current_week` can resolve to nothing for the current
# ATM strike. `InstrumentSearchService._expiry_candidates` automatically
# falls back to concrete Thursday dates (next two Thursdays) and
# `current_month`, so leave this set to `current_week` unless you have a
# specific reason not to.
#
# NIFTY_SEARCH_USE_ATM_OFFSET is a legacy flag from an earlier iteration
# and is no longer consulted by any code path. Kept for backward
# compatibility with any external scripts that import it.
NIFTY_STRIKE_STEP=50
NIFTY_SEARCH_EXCHANGE=NSE
NIFTY_SEARCH_SEGMENT=FO
NIFTY_SEARCH_EXPIRY=current_week
NIFTY_SEARCH_USE_ATM_OFFSET=false
ISOLATION_OPTION_LTP_WAIT_SECONDS=5

# NIFTY trend
NIFTY_TREND_MA_PERIOD=20
NIFTY_TREND_SLOPE_LOOKBACK=5
NIFTY_TREND_NEUTRAL_FALLBACK=CE

# OR levels
OR_FETCH_UNIT=minutes
OR_FETCH_INTERVAL=1
OR_AUTO_COMPUTE_ON_STARTUP=true

# Isolation scan
#
# When the 30-second scan may begin. If ISOLATION_SCAN_START_HOUR /
# ISOLATION_SCAN_START_MINUTE are UNSET, the scan falls back to
# MARKET_OPEN_HOUR / MARKET_OPEN_MINUTE (09:15 by default). We recommend
# setting these explicitly to 09:18 so the scan window opens exactly at
# the same instant the deferred-startup cutoff fires and OR levels
# become available — otherwise the 09:15–09:18 scans no-op harmlessly
# but add log noise.
ISOLATION_SCAN_INTERVAL_SECONDS=30
ISOLATION_SCAN_START_HOUR=9
ISOLATION_SCAN_START_MINUTE=18
ISOLATION_SCAN_END_HOUR=15
ISOLATION_SCAN_END_MINUTE=40

# Backfill
BACKFILL_WINDOW_START_HOUR=9
BACKFILL_WINDOW_START_MINUTE=15
BACKFILL_WINDOW_END_HOUR=23
BACKFILL_WINDOW_END_MINUTE=59
BACKFILL_ENABLED=true

# ---------------------------------------------------------------------------
# Deferred startup gate
#
# Controls whether the process runs its startup sequence (token fetch →
# validate → feed connect → OR levels → backfill) immediately at process
# start, or goes fully idle until a cutoff time and runs it then.
#
#   TEST_FLAG=true   → ALWAYS run the startup sequence immediately,
#                      regardless of current time. Use for local dev,
#                      CI, and manual testing.
#
#   TEST_FLAG=false  → If the process starts BEFORE the cutoff, go fully
#                      idle: no token fetch, no feed connect, no OR
#                      prep, no backfill. Register a one-shot
#                      `deferred_startup` scheduler job at the cutoff.
#                      When that job fires it runs the full startup
#                      sequence in order (daily refresh → backfill).
#
#                      If the process starts AT OR AFTER the cutoff, run
#                      the startup sequence immediately (same as
#                      TEST_FLAG=true).
#
# The recurring `daily_refresh` cron (DAILY_REFRESH_HOUR:MINUTE) and the
# `deferred_startup` one-shot (DEFERRED_STARTUP_HOUR:MINUTE) land at the
# same instant when both are set to 09:18. This is safe by design:
# `run_daily_refresh` has BOTH a per-day idempotency guard AND a
# process-wide `threading.Lock`. Only one of the two callers actually
# runs the pipeline; the other blocks on the lock, observes the guard
# already set, and no-ops with a log line. Without the lock, both
# callers could pass the guard simultaneously and double-run the
# pipeline — two feed threads, doubled [HEALTH] output every 300 s, and
# two Telegram summaries. Keep this lock in place when modifying
# `jobs/daily_refresh.py`.
#
# NOTE on DEFERRED_STARTUP_MINUTE:
#   Values < 17 cause the deferred OR-levels compute to run BEFORE the
#   09:15 opening candle exists. `ORLevelsService` will then fetch
#   yesterday's candles and tag the resulting document
#   `trade_date_ist=<today>` — technically correct per the code path
#   but structurally wrong for the session. Recommended value: 18.
#
# NOTE on DAILY_REFRESH_MINUTE:
#   Set this to the SAME value as DEFERRED_STARTUP_MINUTE. If it is
#   earlier (e.g. 09:00), the daily_refresh cron fires first, computes
#   OR levels from yesterday's candles, and marks the day as refreshed
#   via the idempotency guard before the deferred startup has a chance
#   to run — leaving OR levels structurally wrong for the session.
# ---------------------------------------------------------------------------
TEST_FLAG=false
DEFERRED_STARTUP_HOUR=9
DEFERRED_STARTUP_MINUTE=18

# Session
TIMEZONE=Asia/Kolkata
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=40
DAILY_REFRESH_HOUR=9
DAILY_REFRESH_MINUTE=18
PIVOT_CHECK_HOUR=9
PIVOT_CHECK_MINUTE=18
DISCONNECT_HOUR=15
DISCONNECT_MINUTE=45

# API
API_HOST=0.0.0.0
API_PORT=8001

