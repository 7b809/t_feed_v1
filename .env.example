# .env.example

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=UPSTOX_APP_V2

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstox
UPSTOX_API_VERSION=2.0
UPSTOX_SEARCH_URL=https://api.upstox.com/v2/instruments/search

# Feed
FEED_MODE=full
LOG_RAW_FEED=false
FEED_HEALTH_INTERVAL_SECONDS=300
FEED_STALE_AFTER_SECONDS=120

# Index priority
STRATEGY_INDEX_PRIORITY=NSE_INDEX|NIFTY MID SELECT,NSE_INDEX|Nifty Bank,NSE_INDEX|Nifty 50,BSE_INDEX|SENSEX

# Bias fallback (used only if NIFTY trend is NEUTRAL)
STRATEGY_RELATIONAL_R3_BIAS=CE
STRATEGY_RELATIONAL_S3_BIAS=PE

# Bias source: nifty_trend | trigger_side
ISOLATION_BIAS_SOURCE=nifty_trend

# Isolation execution-mode thresholds (§6.1)
ISOLATION_MODE_CUTOFF_HOUR=10
ISOLATION_MODE_CUTOFF_MINUTE=30
ISOLATION_MODE_PRICE_HIGH=250
ISOLATION_MODE_PRICE_LOW=100

# NIFTY option search
NIFTY_STRIKE_STEP=50
NIFTY_SEARCH_EXCHANGE=NSE
NIFTY_SEARCH_SEGMENT=FO
NIFTY_SEARCH_EXPIRY=current_week
NIFTY_SEARCH_USE_ATM_OFFSET=false
ISOLATION_OPTION_LTP_WAIT_SECONDS=5

# NIFTY trend
NIFTY_TREND_MA_PERIOD=20
NIFTY_TREND_SLOPE_LOOKBACK=5
NIFTY_TREND_NEUTRAL_FALLBACK=CE

# OR levels
OR_FETCH_UNIT=minutes
OR_FETCH_INTERVAL=1
OR_AUTO_COMPUTE_ON_STARTUP=true

# Isolation scan
ISOLATION_SCAN_INTERVAL_SECONDS=30
ISOLATION_SCAN_END_HOUR=15
ISOLATION_SCAN_END_MINUTE=40

# Backfill
BACKFILL_WINDOW_START_HOUR=9
BACKFILL_WINDOW_START_MINUTE=15
BACKFILL_WINDOW_END_HOUR=23
BACKFILL_WINDOW_END_MINUTE=59
BACKFILL_ENABLED=true

# ---------------------------------------------------------------------------
# Deferred startup gate
#
# Controls whether the process runs its startup sequence (token fetch →
# validate → feed connect → OR levels → backfill) immediately at process
# start, or goes fully idle until a cutoff time and runs it then.
#
#   TEST_FLAG=true   → ALWAYS run the startup sequence immediately,
#                      regardless of current time. Use for local dev,
#                      CI, and manual testing.
#
#   TEST_FLAG=false  → If the process starts BEFORE the cutoff, go fully
#                      idle: no token fetch, no feed connect, no OR
#                      prep, no backfill. Register a one-shot
#                      `deferred_startup` scheduler job at the cutoff.
#                      When that job fires it runs the full startup
#                      sequence in order (daily refresh → backfill).
#
#                      If the process starts AT OR AFTER the cutoff, run
#                      the startup sequence immediately (same as
#                      TEST_FLAG=true).
#
# The recurring `daily_refresh @ 09:00` cron and the `deferred_startup`
# one-shot can land at the same instant. This is safe — `run_daily_refresh`
# has a per-day idempotency guard so only the first actually runs the
# pipeline; the second no-ops with a log line.
#
# NOTE on DEFERRED_STARTUP_MINUTE:
#   Values < 17 cause the deferred OR-levels compute to run BEFORE the
#   09:15 opening candle exists. `ORLevelsService` will then fetch
#   yesterday's candles and tag the resulting document
#   `trade_date_ist=<today>` — technically correct per the code path
#   but structurally wrong for the session. Recommended value: 17 or 18.
# ---------------------------------------------------------------------------
TEST_FLAG=false
DEFERRED_STARTUP_HOUR=9
DEFERRED_STARTUP_MINUTE=0

# Session
TIMEZONE=Asia/Kolkata
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=40
DAILY_REFRESH_HOUR=9
DAILY_REFRESH_MINUTE=0
PIVOT_CHECK_HOUR=9
PIVOT_CHECK_MINUTE=18
DISCONNECT_HOUR=15
DISCONNECT_MINUTE=45

# API
API_HOST=0.0.0.0
API_PORT=8001

# ---------------------------------------------------------------------------
# Isolation client notifications
# ---------------------------------------------------------------------------
# When true, POST the complete persisted isolation document to each URL.
# The POST requests run in daemon threads; isolation processing does not
# wait for client responses. URLs are comma-separated.
ISOLATION_NOTIFY_ENABLED=false
ISOLATION_NOTIFY_CLIENT_URLS=

# Shared secret used to authenticate outbound isolation POSTs.
# Both this service (sender) and each client (receiver) MUST configure
# the SAME value, otherwise the receiver is expected to reject the
# payload. Leave empty to send without a key header (unauthenticated).
ISOLATION_NOTIFY_CLIENT_KEY=

# Name of the HTTP header under which the shared key is sent.
# Change only if your receiver expects a different header name.
# Example customizations:
#   X-Isolation-Key   (default)
#   X-API-Key
#   Authorization     (then set ISOLATION_NOTIFY_CLIENT_KEY="Bearer <secret>")
ISOLATION_NOTIFY_CLIENT_KEY_HEADER=X-Isolation-Key

ISOLATION_NOTIFY_TIMEOUT_SECONDS=5