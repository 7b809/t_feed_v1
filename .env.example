# .env.example
# ===========================================================================
# ⚠️  SECRETS TEMPLATE — DO NOT COMMIT THIS FILE WITH REAL VALUES FILLED IN
# ===========================================================================
# This file is a TEMPLATE (safe to commit).
# Copy it to `.env` locally and fill in the real values there:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Every value shown as `<placeholder>` in this
# template MUST be replaced locally and NEVER committed.
#
# The file is deliberately split into two sections:
#   (1) SECRETS & CREDENTIALS       — sensitive; keep out of source control
#   (2) APPLICATION CONFIGURATION   — non-sensitive; safe to commit
#
# G1 v4.1 additions (2026-10-29)
# ------------------------------
# Six opt-out flags are added at the bottom of the file, each tied to
# one fix from the `/isolated` page analysis:
#
#     STRATEGY_ENTRY_REGISTER_COUNTER_SIDE       (§5.A)
#     STRATEGY_ENTRY_CANDLE_FALLBACK_ENABLED     (§5.B)
#     STRATEGY_ENTRY_TARGET_REQUIRE_POST_ENTRY   (§5.C)
#     LEVEL_ISOLATION_REPLAY_USE_SERIES_OR       (§5.D)
#     LEVEL_ISOLATION_OR_SELF_HEAL_VERIFY_HL     (§5.D)
#     STRATEGY_ENTRY_FREEZE_ENTRY_ON_PROMOTION   (§5.E)
#
# Every flag defaults to true (fixed behaviour). Set any one to false
# to restore the pre-v4.1 path for that single aspect — useful for
# bisecting a regression without reverting the whole bundle.
#
# Determinism contract (2026-11-04)
# ---------------------------------
# The post-isolation execution pipeline is required to be deterministic:
#
#     same trading day
#   + same isolation record (bias-side instrument, T_iso, trigger_index)
#   + same intraday-API response
#   = SAME set of dummy orders
#
# regardless of process start time (09:20 IST live vs. 14:16 IST restart
# vs. 20:00 IST post-close replay).
#
# Six DUMMY_ORDER_* flags enforce this contract; they all default to the
# safe deterministic behaviour and are documented in the DUMMY ORDERS
# section below. NOTE: the STRATEGY_ENTRY_* flags do NOT influence order
# placement any more — they only affect /simulation diagnostics (see the
# SIMULATION-ONLY banner in the STRATEGY ENTRY SIGNAL section).
#
# Live sandbox execution (2026-11-04)
# -----------------------------------
# A new SANDBOX EXECUTION section (below DUMMY ORDERS) documents the
# SANDBOX_* env vars that drive services/sandbox_execution_service.py.
# The sandbox mirrors dummy-order transitions onto real broker orders,
# but ONLY when all eight gates pass (reason=scheduled, env gate,
# mode=live, runtime toggle on, SR backfill ready, market hours,
# idempotency ledger miss, single-position lock free).
#
# The default deployment is INERT: SANDBOX_EXECUTION_ENABLED=false plus
# SANDBOX_EXECUTION_MODE=observe means zero broker calls regardless of
# how the runtime toggle is set. To actually place live sandbox orders
# you must BOTH set the env gate here AND call
# POST /admin/orders/runtime-enable after startup.
# ===========================================================================

# ===========================================================================
# 1. SECRETS & CREDENTIALS
# ===========================================================================
# ⚠️  SENSITIVE.
# Every value in this section grants access to an external system
# (database, chat bot, or cloud account). Leaking any of them is a
# security incident: rotate the credential immediately, audit logs,
# and re-issue a fresh value.
#
# NEVER paste these values into tickets, chat, screenshots, PR
# comments, or commits. NEVER echo them from a shell or a log line.
# ===========================================================================

# ---- MongoDB connection URI --------------------------------------------
# Contains username + password + cluster hostname. Full write access to:
#   * the Upstox token store,
#   * the candle-backup archive,
#   * the daily-backup progress-state collection.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# ---- Telegram bot credentials ------------------------------------------
# The bot token can send messages as your bot. The chat id is the ONLY
# chat the bot accepts commands from (token bot refuses everyone else
# when TELEGRAM_TOKEN_BOT_RESTRICT_TO_CHAT=true).
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<authorized-chat-id>

# ---- MEGA cloud account (daily backup destination) ---------------------
# ⚠️  Full account credentials — not a scoped API key. The account
# receives every daily data/ zip. Treat it as production-grade.
MEGA_EMAIL=<mega-account-email>
MEGA_PASSWORD=<mega-account-password>

# ===========================================================================
# 2. APPLICATION CONFIGURATION (NON-SECRET)
# ===========================================================================
# Everything below is plain configuration. None of these values on their
# own can authenticate to an external system. Safe to commit.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application port
# ---------------------------------------------------------------------------
# Used by the readiness smoke-test probes (http://127.0.0.1:<PORT>/...).
# MUST match the port the app is actually listening on:
#
#     run.bat / start.sh   -> 8010  (default)
#     Procfile             -> 8000  (override PORT=8000)
#     manual uvicorn       -> whatever --port is passed
#
# A wrong value here causes the smoke test to fail with a
# ConnectionRefused and the 08:45 readiness digest to report YELLOW.
# That is intentional: a probe that cannot reach the app is a real
# (if minor) degradation and should be visible.
PORT=8010

# ---------------------------------------------------------------------------
# MongoDB database / collection names (referenced by §1 MONGO_URL)
# ---------------------------------------------------------------------------
# Main V5 operational data database.
MONGO_DB=MARKET_ENGINE_V5

# V4 historical-candle archive source.
# Set this to the exact MONGO_DB value in the running V4 engine's .env.
# This is intentionally separate from V5's operational MONGO_DB.
BACKUP_MONGO_DB=

# Shared Upstox token source — intentionally matches the V4 token store.
UPSTOX_TOKEN_MONGO_DB=UPSTOX_APP_V2
TOKENS_COLLECTION=auth_tokens
UPSTOX_TOKEN_DOC_ID=upstox_access_token

# ---------------------------------------------------------------------------
# Market time zone & formatting
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
MARKET_TIME_FORMAT=%Y-%m-%d %H:%M:%S %Z

# ---------------------------------------------------------------------------
# Telegram bot behaviour (feature toggle + polling)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_TOKEN_BOT_ENABLED=false
TELEGRAM_TOKEN_BOT_POLL_SECONDS=3
TELEGRAM_TOKEN_BOT_LONG_POLL_TIMEOUT=20
TELEGRAM_TOKEN_BOT_RESTRICT_TO_CHAT=true

# Windows start confirmation (see token_tasks/telegram_token_bot.py).
# On Windows with an interactive console, the bot asks the operator to
# confirm before beginning Telegram polling (5 s timeout, default No).
# Headless deployments (Windows Service, scheduled task, no TTY) would
# never see the prompt and would therefore never start the bot — set
# this flag to true to bypass the prompt and start immediately.
# Non-Windows (Linux / macOS): the flag is ignored; the bot always
# starts as before.
# TELEGRAM_BOT_SKIP_WINDOWS_PROMPT=false
# TELEGRAM_BOT_WINDOWS_PROMPT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Token validity monitoring
# ---------------------------------------------------------------------------
UPSTOX_TOKEN_CHECK_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Chart history requests
# ---------------------------------------------------------------------------
CHART_MAX_BATCH_WORKERS=8
CHART_LIVE_POLL_SECONDS=30

# ---------------------------------------------------------------------------
# Backup extraction (from the candle-backup MongoDB documents)
# ---------------------------------------------------------------------------
# These collection/document names must match the V4 candle-backup producer.
# The database itself is selected independently by BACKUP_MONGO_DB above.
BACKUP_METADATA_COLLECTION=app_tokens
BACKUP_METADATA_DOC_ID=backup_candles
BACKUP_BLOB_COLLECTION=backup_collection
BACKUP_BLOB_DOC_ID=backup_historical_candles

# Where the extracted backup tree lives locally.
LIVE_DATA_DIR=data
# 0 = always re-extract on startup; >0 = skip if the archive is fresh.
BACKUP_MAX_AGE_MINUTES=0

# ---------------------------------------------------------------------------
# Upstox live feed (WebSocket)
# ---------------------------------------------------------------------------
# Mode: full | ltpc | full_d30 | option_greeks
UPSTOX_WS_MODE=full
UPSTOX_WS_AUTO_START=true
UPSTOX_WS_RECONNECT_INTERVAL=10
# 0 = infinite reconnect attempts
UPSTOX_WS_MAX_RETRIES=0

# ---------------------------------------------------------------------------
# Live EMA cross engine
# ---------------------------------------------------------------------------
# Retained for compatibility until services/live_ema_engine.py and
# services/live_cross_store.py are fully removed. The live feed no
# longer calls live_ema_engine.on_tick(), and the cross handler is
# being stripped from the admin / live routes.
#
# Delete this block once those two service files are gone.
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_ATR_PERIOD=14
EMA_VOLUME_LOOKBACK=20
EMA_SLOPE_LOOKBACK=3
EMA_SEP_ATR_MIN=0.15
EMA_VOLUME_MULT=1.0
EMA_DISTANCE_ATR_MAX=1.5
EMA_MIN_VALIDATION_SCORE=3
EMA_ENABLE_VALIDATION=true

# Filename written inside each instrument folder for today's live crosses.
LIVE_CROSSES_FILENAME=live_crosses.json

# ---------------------------------------------------------------------------
# Daily refresh scheduler (Mon–Fri by default)
# ---------------------------------------------------------------------------
# 08:30 IST — the industry-standard "pre-open warm-up window":
# 30 minutes before the 09:00 premarket and 45 minutes before the
# 09:15 cash open. Enough time to catch a failure, fix it, and still
# be ready for the open.
#
# The readiness stack is timed around this:
#     08:30  daily refresh runs
#     08:45  readiness digest (GREEN/YELLOW/RED + per-check)
#     09:05  pre-flight recheck (alert on any regression)
#     09:15  cash open
DAILY_REFRESH_ENABLED=true
DAILY_REFRESH_HOUR=8
DAILY_REFRESH_MINUTE=30
DAILY_REFRESH_DAYS=mon,tue,wed,thu,fri

# ---------------------------------------------------------------------------
# Readiness / pre-flight
# ---------------------------------------------------------------------------
# The readiness pipeline produces ONE aggregate GREEN/YELLOW/RED status
# from ~10 independent subsystem checks (token, registry, Mongo, live
# feed, scheduler, clock drift, disk, order toggle, ...) and surfaces
# it on Telegram. Two scheduled jobs consume it:
#
#     08:45  READINESS_DIGEST_*     short, glanceable Telegram digest
#     09:05  READINESS_PREFLIGHT_*  re-check + intervention alert
#
# The startup config validator (services/config_validation.py)
# enforces digest < preflight, so a misconfiguration here fails
# loudly at startup rather than silently producing no alerts.
READINESS_DIGEST_ENABLED=true
READINESS_DIGEST_HOUR=8
READINESS_DIGEST_MINUTE=45

READINESS_PREFLIGHT_ENABLED=true
READINESS_PREFLIGHT_HOUR=9
READINESS_PREFLIGHT_MINUTE=5

# Per-check thresholds. Any check that returns "fail" turns the
# aggregate RED; any "warn" turns it YELLOW; all-ok is GREEN.
#
#   READINESS_CLOCK_DRIFT_MAX_SECONDS   NTP drift; > this -> fail
#   READINESS_DISK_FREE_MIN_GB          project root disk free
#   READINESS_REGISTRY_MIN_COUNT        instrument_registry count
#   READINESS_TOKEN_MAX_AGE_MINUTES     last_validated_at on token doc
#   READINESS_SMOKE_TEST_ENABLED        if false, skip the HTTP probes
#                                       (use when the app is not
#                                       listening on 127.0.0.1:PORT,
#                                       e.g. a container that needs
#                                       a service hostname instead)
READINESS_CLOCK_DRIFT_MAX_SECONDS=30
READINESS_DISK_FREE_MIN_GB=1.0
READINESS_REGISTRY_MIN_COUNT=100
READINESS_TOKEN_MAX_AGE_MINUTES=120
READINESS_SMOKE_TEST_ENABLED=true

# ---------------------------------------------------------------------------
# Health feed log
# ---------------------------------------------------------------------------
HEALTH_FEED_LOG=true
HEALTH_FEED_INSTRUMENT="NSE_INDEX|Nifty 50"
HEALTH_FEED_INSTRUMENT_INTERVAL=5

# ---------------------------------------------------------------------------
# Pipeline logging verbosity
# ---------------------------------------------------------------------------
# When false (default), pipeline modules log ONLY lifecycle lines
# (START / COMPLETED / FAILED, per-index one-liners) and never dump
# the full per-instrument summary dicts. Set to true when debugging
# to see every per-instrument decision, candle count, and window
# extreme.
#
# Consumer: routes/admin_routes.py, services/scheduler_service.py,
# and the token_tasks/*.py scheduled wrappers.
VERBOSE_LOG=false

# ---------------------------------------------------------------------------
# Transient folder cleanup (startup / daily refresh / hard refresh)
# ---------------------------------------------------------------------------
# Comma-separated list of folders (relative to the project root) that
# the cleanup service will remove. Reserved folders take priority — if
# a name appears in both lists, the reserved list wins and the folder
# is preserved.
#
# Default remove list is the transient state only. `logs` and
# `logs_text` are deliberately NOT in it: the logger holds open file
# handles into those directories at import time, and removing them
# mid-process breaks log rotation on Linux (file unlinked but still
# written) and fails outright on Windows.
#
# The reserved list protects directories that would corrupt the app
# if removed: meta backups, code tree, virtualenv, git metadata.
#
# CLEANUP_REMOVE_FOLDERS=data,temp,downloads,output,__pycache__,.pytest_cache,htmlcov,test_logs
# CLEANUP_RESERVED_FOLDERS=meta_data,logs,logs_text,.git,.venv,venv,myenv,templates,routes,services,core,token_tasks,static,tests

# ---------------------------------------------------------------------------
# /live/* route behaviour
# ---------------------------------------------------------------------------
# Allow /live/* routes to make a best-effort Upstox search when a
# triple lookup misses the registry. Set to false to force strict
# registry-only lookups.
# LIVE_RESOLVE_ON_MISS=true

# ---------------------------------------------------------------------------
# DAILY BACKUP — zip folders → upload to MEGA → track progress in MongoDB
# ---------------------------------------------------------------------------
# Scheduler trigger
DAILY_BACKUP_ENABLED=false
DAILY_BACKUP_HOUR=16
DAILY_BACKUP_MINUTE=0
DAILY_BACKUP_DAYS=mon,tue,wed,thu,fri,sat,sun

# Folders (relative to the project root) to zip each run.
# Each folder is zipped separately into:
#     <MEGA_BACKUP_ROOT>/<folder>/<folder>_<YYYY-MM-DD>.zip
DAILY_BACKUP_FOLDERS=data

# MEGA upload toggle + remote folder layout.
MEGA_ENABLED=false
# Remote folder layout under the MEGA root:
#   <MEGA_BACKUP_ROOT>/<folder>/<folder>_<YYYY-MM-DD>.zip
#   e.g. market_engine_backup/data/data_2026-10-20.zip
MEGA_BACKUP_ROOT=market_engine_backup

# MongoDB progress-state tracking for the daily backup.
# NOT the archive — the archive lives on MEGA. This collection holds
# ONE document per date, keyed by _id = "YYYY-MM-DD", tracking whether
# each folder's zip was uploaded, its size, MEGA link, and error (if any).
DAILY_BACKUP_MONGO_DB=UPSTOX_APP_V2
DAILY_BACKUP_STATE_COLLECTION=daily_backup_state

# How many date-documents the /admin/daily-backup-status endpoint returns.
DAILY_BACKUP_STATE_DAYS=7

# Source label written to the folder field (defaults to project dir name).
# DAILY_BACKUP_SOURCE_LABEL=market-engine-v1

# DEPRECATED — previously the inline Mongo blob limit. Kept for
# backward compatibility with existing .env files. Ignored by the
# MEGA-based implementation.
# DAILY_BACKUP_MAX_BLOB_MB=15

# ---------------------------------------------------------------------------
# First-candle OR + EMA-cross detection (09:16:10 Mon-Fri)
# ---------------------------------------------------------------------------
# Runs 10 s after the 09:15 first candle closes. Fetches first candle
# for every registered instrument, computes OR levels, detects any new
# EMA cross, and writes first_candle.json per instrument folder.
FIRST_CANDLE_ENABLED=true
FIRST_CANDLE_HOUR=9
FIRST_CANDLE_MINUTE=16
FIRST_CANDLE_SECOND=10
FIRST_CANDLE_WORKERS=8

# ===========================================================================
# LEVEL-INSTRUMENT FILTER — per-index CE/PE strike list from OR levels
# ===========================================================================
# After first_candle_service computes OR levels, level_instrument_filter_service
# reads data/index/<underlying>/first_candle.json and produces
# data/index/<underlying>/level_instruments.json containing the CE/PE strikes
# that map to R1/R2/R3/R3_Threshold and S1/S2/S3/S3_Threshold.
#
# Every unique rounded strike is emitted on BOTH sides (CE *and* PE) so
# the dashboard shows the two option contracts side by side at each
# filtered strike. Each entry carries an explicit "type" field.
#
# This file is a UI/analysis artefact. It is independent of the live SR
# engine, which (with LIVE_SR_TRACK_ALL_INSTRUMENTS=true) tracks every
# subscribed instrument, not just these filtered strikes.
#
# Output path:
#   data/index/<underlying_lower>/level_instruments.json
#
# G1 v3.2 — LEVEL_FILTER_INDEXES now defaults to all four monitored
# indices so first_candle.json exists for every index the touch engine
# watches. Only NIFTY's level_instruments.json is consumed for
# execution (the other three are informational). Strike step per
# underlying is configurable below.
# ===========================================================================
LEVEL_FILTER_ENABLED=true

# Which index underlyings to filter (comma-separated canonical tickers).
LEVEL_FILTER_INDEXES=NIFTY,BANKNIFTY,MIDCPNIFTY,SENSEX

# Default strike step per index (used when LEVEL_FILTER_STRIKE_STEPS_JSON
# does not override the value).
LEVEL_FILTER_STRIKE_STEP_NIFTY=50
LEVEL_FILTER_STRIKE_STEP_SENSEX=100
LEVEL_FILTER_STRIKE_STEP_BANKNIFTY=100
LEVEL_FILTER_STRIKE_STEP_MIDCPNIFTY=25

# Optional JSON override. When present and valid, this map wins over the
# scalar step values above.
#   Example: {"NIFTY":50,"SENSEX":100,"BANKNIFTY":100,"FINNIFTY":50}
# LEVEL_FILTER_STRIKE_STEPS_JSON={"NIFTY":50,"SENSEX":100}

# Range filter mode:
#   "wide"   -> S3 <= strike <= R3              (default; all OR strikes)
#   "strict" -> S3_Threshold <= strike <= R3_Threshold
# Core level strikes are always kept even under "strict" mode (the range
# only gates the optional ATM extras).
LEVEL_FILTER_RANGE_MODE=wide

# Include ATM +/- N strikes in the filter output (in addition to core levels).
# 0 = only the level strikes.
LEVEL_FILTER_INCLUDE_ATM_PLUS_MINUS=0

# When True (default), the filter output also registers the index
# instrument itself with the live SR engine (in addition to the
# filtered CE/PE strikes).
LEVEL_FILTER_INCLUDE_INDEX_SR=true

# ===========================================================================
# LIVE SR LEVELS — pivot-based, computed from live 1-min candles
# ===========================================================================
# Strict pivot rule (matches TradingView ta.pivothigh / ta.pivotlow):
#
#   resistance pivot at bar i  iff
#       C[i].high > C[j].high  for every j in [i-left, i-1]
#                          AND  for every j in [i+1, i+right]
#
#   support pivot at bar i  iff
#       C[i].low  < C[j].low   for every j in [i-left, i-1]
#                          AND  for every j in [i+1, i+right]
#
# A pivot at index i is confirmed at bar i + right_bars. Confirmed pivots
# are written to data/<...>/live_sr_levels.json.
#
# Every confirmed pivot is retained for the day — there is no broken /
# intact distinction. A level that price has crossed stays on the chart,
# matching TradingView's behaviour for pivot lines.
#
# Candle source:
#   * Index feeds (full mode) carry candle_1m (interval "I1") — used directly.
#   * Option feeds (full mode) only carry ltpc — OHLC is built from LTP ticks
#     bucketed to the minute.
#
# Timing note:
#   With the default display window (left=15, right=3), the first pivot
#   is confirmed at ~09:22 IST. With left=right=15 the first pivot can
#   only be confirmed at ~09:47. The entry engine uses a separate fast
#   window (see STRATEGY_ENTRY_PIVOT_*).
# ===========================================================================
LIVE_SR_ENABLED=true

# Track ALL feed-connected instruments (default) vs. only the level-filtered
# strikes. When true (default), every instrument subscribed by the live feed
# gets a data/<...>/live_sr_levels.json file as soon as the feed starts.
# When false, only the instruments explicitly registered by other services
# (level_instrument_filter_service) are tracked.
LIVE_SR_TRACK_ALL_INSTRUMENTS=true

# Bars to the left / right of a candidate pivot used for the strict
# comparison. Both sides must strictly exceed (resistance) / be strictly
# below (support) the candidate.
LIVE_SR_LEFT_BARS=15
LIVE_SR_RIGHT_BARS=3

# Rolling buffer of 1-min candles kept per tracked instrument. The oldest
# candles beyond this cap are dropped. Must be >= LEFT_BARS + RIGHT_BARS + 1.
LIVE_SR_MAX_CANDLES=500

# Output filename written next to the instrument's candles.json /
# first_candle.json.
LIVE_SR_FILENAME=live_sr_levels.json

# Persistence throttle. The file is ALWAYS written:
#   * on initial registration (empty file so readers never see a missing file)
#   * when a new pivot is confirmed
# Additionally, the file is refreshed every N finalized candles so that
# "candle_count" and "last_candle" do not drift stale. 0 disables the
# periodic refresh (write only on register / pivot). 1 writes on
# every candle close. Default 5 balances freshness against I/O load on
# a ~245-instrument registry.
LIVE_SR_PERSIST_EVERY_N_CANDLES=5

# ===========================================================================
# SR BACKFILL — seed the SR engine from today's intraday candles
# ===========================================================================
# If the process starts mid-session (between SR_BACKFILL_START_HOUR/
# MINUTE and SR_BACKFILL_END_HOUR/MINUTE on a trading day), the SR
# backfill service fetches today's intraday 1-min candles from Upstox
# for every tracked instrument and seeds the SR engine with them:
#
#     upstox_client.HistoryV3Api.get_intra_day_candle_data(
#         instrument_key, "minutes", "1"
#     )
#
# That makes SR levels immediately available on the dashboard, without
# waiting for the live feed to accumulate 31+ candles. The seed is
# idempotent: it clears in-memory candles/levels, rebuilds from the
# intraday response, and persists once at the end.
#
# Window default: 09:15 -> 23:59 IST. Weekends and holidays are
# skipped automatically. A Telegram summary is sent on the
# feed_start path (a log line at INFO is always written).
#
# When SR_BACKFILL_INCLUDE_HISTORICAL is true (default), the backfill
# also merges the instrument's historical candles.json tail so pivots
# that formed near the session open (which need 15 bars *before* the
# first tick) are detected — matching the on-demand calc's view.
#
# 2026-11-04 — readiness latch
# ----------------------------
# The service exposes is_ready() / is_ready_for_today() as a process-
# local latch set once today's full backfill completes. Consumed by:
#   * main.py (_wait_for_sr_backfill_ready)
#   * scheduler_service.sr_backfill_ready()
#   * dummy_order_service._upstream_ready()
#   * sandbox_execution_service._gate()  (NEW)
# Without the alias, all three of the latter fall into their "missing
# probe" branch. Do not rename it.
# ===========================================================================
SR_BACKFILL_ENABLED=true
SR_BACKFILL_MAX_WORKERS=4
SR_BACKFILL_START_HOUR=9
SR_BACKFILL_START_MINUTE=15
SR_BACKFILL_END_HOUR=23
SR_BACKFILL_END_MINUTE=59

# When True (default), the backfill merges historical candles.json with
# today's intraday before seeding. Without this, pivots that need
# context from yesterday's tail are missed.
SR_BACKFILL_INCLUDE_HISTORICAL=true

# ===========================================================================
# G1 v4.0 — MULTI-INDEX BOUNDARY SURVEILLANCE
# ===========================================================================
# The isolation engine watches four indices for R3 / S3 touches and
# applies priority arbitration when multiple touch in the same 2 s
# window. EVERY touch routes to a NIFTY strike regardless of which
# index fired. See also the LEVEL ISOLATION block below.
#
# STRATEGY_MONITORED_INDICES accepts either form in .env:
#     STRATEGY_MONITORED_INDICES=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank,NSE_INDEX|NIFTY MID SELECT,BSE_INDEX|SENSEX
#     STRATEGY_MONITORED_INDICES=["NSE_INDEX|Nifty 50","NSE_INDEX|Nifty Bank","NSE_INDEX|NIFTY MID SELECT","BSE_INDEX|SENSEX"]
#
# Every entry must be one of the four keys the isolation engine knows
# about (defined in services/level_isolated_instrument_service.INDEX_METADATA).
#
# STRATEGY_TOUCH_PRIORITY_ORDER is the canonical-name arbitration
# order for the cross-index touch engine. Under v4.0, MIDCPNIFTY leads
# and BANKNIFTY is the next-highest priority (lead-lag assumption,
# empirically correct on the 2026-10-29 session that produced the
# /isolated page analysis). NIFTY is the routed execution index;
# SENSEX is the BSE anchor.
#
# The priority rank map used by the UI and the touch arbiter is
# derived from this order automatically — changing it here re-ranks
# the touch arbitration without touching service code.
# ===========================================================================
STRATEGY_MONITORED_INDICES=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank,NSE_INDEX|NIFTY MID SELECT,BSE_INDEX|SENSEX
STRATEGY_TOUCH_PRIORITY_ORDER=MIDCPNIFTY,BANKNIFTY,NIFTY,SENSEX
STRATEGY_ROUTED_EXECUTION_INDEX=NSE_INDEX|Nifty 50

# ===========================================================================
# LEVEL ISOLATION — G1 v4.0 multi-index arbitration + NIFTY routing
# ===========================================================================
# After first_candle produces or_levels and level_filter writes
# level_instruments.json, the isolation engine watches all four
# monitored indices for R3 / S3 touches and picks ONE isolated
# instrument per day using the priority order above.
#
# ALWAYS routes to a NIFTY strike:
#     * Bias = CE if the winning touch was R3, PE if it was S3.
#     * Strike = nearest round 50 NIFTY strike to the NIFTY spot LTP
#       at the moment of the winning touch.
#
# On isolation, the picked instrument's OWN data at the moment of the
# touch is also captured — its LTP, touch-minute OHLC (when the exact
# minute bar is available), its own first-candle OHLC, and its own OR
# levels. These are rendered on the /isolated page so the operator
# sees the picked option's price context, not just the index's.
#
# Records created before the snapshot feature existed self-heal on the
# next run of the 5-minute recheck job (or on the next app restart).
# POST /admin/level-isolation/refresh-snapshot triggers the same
# snapshot-only backfill manually.
#
# Persisted to data/<LEVEL_ISOLATION_FILENAME>; a full event log for
# the day is preserved in the same file under "events".
# ===========================================================================
LEVEL_ISOLATION_ENABLED=true

# Output filename under data/ (resolved against LIVE_DATA_DIR).
LEVEL_ISOLATION_FILENAME=level_isolated_instrument.json

# Throttle for the on-tick touch check (per any monitored-index tick).
# The check runs at most once every N seconds regardless of tick rate.
LEVEL_ISOLATION_CHECK_INTERVAL_SECONDS=2.0

# Max age (seconds) of the last NIFTY tick before it is treated as
# stale during NIFTY routing. Under v4.0 the routing always needs a
# fresh NIFTY spot LTP; when NIFTY is stale the touch is still
# recorded but isolation is deferred until the next NIFTY tick.
LEVEL_ISOLATION_NIFTY_TICK_STALE_SECONDS=30

# Startup backfill window (intraday-candle replay). Widened to start
# at 09:15 (instead of 09:16) so the 09:15 opening candle is included
# in the replay that builds today's OR levels. End is 23:59 so a
# 23:46 startup still reconstructs the whole session.
LEVEL_ISOLATION_BACKFILL_WINDOW_START_HOUR=9
LEVEL_ISOLATION_BACKFILL_WINDOW_START_MINUTE=15
LEVEL_ISOLATION_BACKFILL_WINDOW_END_HOUR=23
LEVEL_ISOLATION_BACKFILL_WINDOW_END_MINUTE=59

LEVEL_ISOLATION_TELEGRAM_ENABLED=false

# ===========================================================================
# ISOLATED SR TRACKER — watch SR confirmations for the isolated instrument
# ===========================================================================
# When an instrument is isolated (see LEVEL ISOLATION above), the
# isolated_sr_tracker_service snapshots every SR level currently
# recorded by live_sr_levels_service as "pre-isolation" and then
# watches for NEW pivot confirmations on the SAME instrument for the
# rest of the day.
#
# Every new confirmation is:
#   * recorded under "post_isolation_levels",
#   * persisted (sidecar file, separate from the isolation state file),
#   * shown on /isolated (dedicated SR Tracking card),
#   * announced on Telegram (when the toggle below is true).
#
# Both `pre_isolation_levels` and `post_isolation_levels` are returned
# sorted by price ascending (supports and resistances intermixed,
# matching TradingView). Every confirmed pivot is retained for the day
# — there is no broken / intact distinction.
#
# Sidecar file (relative to LIVE_DATA_DIR):
#     data/<LEVEL_ISOLATION_SR_FILENAME>
#
# Dedup key: (level_type, price, confirmed_time).  Consequences:
#   * re-seeding the SR engine does not double-count pivots;
#   * a level already snapshotted as pre-isolation is never re-added
#     as post-isolation;
#   * a genuinely new pivot (new candle) that happens to share a price
#     with an older one is still recorded.
#
# Related code:
#   services/isolated_sr_tracker_service.py      (tracker + persistence)
#   services/level_isolated_instrument_service.py (_isolate / get_detail)
#   services/live_sr_levels_service.py            (_append_level hook)
#   routes/isolated_instrument_routes.py          (/sr-tracking endpoint)
#   templates/isolated_instrument.html            (SR Tracking card)
# ===========================================================================

# Output filename under data/ (resolved against LIVE_DATA_DIR).
LEVEL_ISOLATION_SR_FILENAME=level_isolated_instrument_sr.json

# When true (default), every new post-isolation SR confirmation fires
# a Telegram message.  When false, confirmations are still persisted
# and shown on the dashboard; only the Telegram send is suppressed.
LEVEL_ISOLATION_SR_TELEGRAM_ENABLED=false

# ===========================================================================
# LIVE SR CALC — on-demand stateless SR computation
# ===========================================================================
# Feeds the /live-sr/calc endpoints.
#
#   services/live_sr_calc_service.py
#   routes/live_sr_calc_routes.py
#
# Unlike LIVE SR LEVELS above (which maintains per-instrument state and
# persists to data/<...>/live_sr_levels.json), this calculator is
# STATELESS.  Every call always fetches fresh data:
#
#   1. Historical candles from data/<...>/candles.json
#      (window controlled by LIVE_SR_CALC_DEFAULT_LOOKBACK_DAYS)
#   2. Today's intraday 1-min candles from Upstox HistoryV3Api
#      (get_intra_day_candle_data)
#
# Then runs the same strict-pivot scan as live_sr_levels_service on the
# merged series and returns the resulting levels. Intraday wins on any
# minute collision.
#
# Every response is deterministic for the same underlying data, so
# callers can poll the endpoint safely — no shared state, no disk writes.
#
# Levels are returned sorted by price ascending (supports and
# resistances intermixed, matching TradingView). Every confirmed pivot
# is retained for the day — there is no broken / intact distinction.
#
# Endpoints:
#   GET  /live-sr/calc?instrument_key=...          (or triple params)
#   GET  /live-sr/calc/{underlying}/{strike}/{type}
#   POST /live-sr/calc/batch
#
# Example URLs:
#   GET /live-sr/calc/nifty/23500/ce
#   GET /live-sr/calc?underlying=NIFTY&strike=23500&type=PE&only_today=true
#   GET /live-sr/calc?instrument_key=NSE_FO|51327&lookback_days=3
# ===========================================================================

# Default historical lookback window (days). 1..30, default 5.
# Larger values include more historical pivots in the response; smaller
# values reduce the payload and pivot-scan time.
LIVE_SR_CALC_DEFAULT_LOOKBACK_DAYS=5

# Hard cap on the number of merged candles used for pivot detection.
# 100..10000, default 3000.  Also bounds the largest acceptable
# left_bars + right_bars + 1 combination — the calculator rejects
# requests whose window would exceed this cap.
LIVE_SR_CALC_MAX_CANDLES=3000

# ===========================================================================
# LIVE SR — accuracy tuning
# ===========================================================================
# Periodic re-seed of the live SR engine from the authoritative Upstox
# intraday API. Fixes the drift between tick-aggregated option candles
# and the true minute OHLC, so freshly confirmed pivots land in the
# persisted file within the configured lag.
#
# Each refresh issues one intraday call per tracked instrument. Higher
# intervals reduce Upstox API load at the cost of a larger accuracy lag
# on the freshest pivot.
#
# Set to False to disable the scheduler job entirely — the feed-start
# backfill (SR_BACKFILL_*) still runs.
#
# 2026-11-04 — LIVE BUFFER ONLY. This tick no longer reseeds the
# replay series used by the startup catch-up (see
# services/scheduler_service.py::_LIVE_SR_REFRESH_UPDATE_REPLAY). The
# replay series is frozen after the startup backfill, so the same day +
# same isolation record + same intraday-API response always produce the
# same dummy orders regardless of when the process started.
# ===========================================================================
LIVE_SR_REFRESH_FROM_API_ENABLED=true

# Refresh interval, in minutes. Default 2. Values 1..60 are supported.
LIVE_SR_REFRESH_FROM_API_MINUTES=2

# ===========================================================================
# ⚠️  SIMULATION-ONLY — STRATEGY_ENTRY_* DOES NOT DRIVE ORDER PLACEMENT
# ===========================================================================
# Determinism contract (2026-11-04)
# ---------------------------------
# The same trading day, the same isolation record, and the same
# intraday-API response MUST produce the SAME set of dummy orders,
# regardless of the process start time. Every flag in THIS section is
# therefore excluded from order placement — they feed ONLY the
# following diagnostic consumers:
#
#     * POST /admin/simulation/run                    (replay diagnostics)
#     * GET  /admin/level-isolation/strategy-signal   (diagnostic view)
#
# Order placement is driven ENTIRELY by services/dummy_order_service.py,
# which reads the STRATEGY_ORDER_* block in core/config.py (stop-loss,
# milestone gain, reversal cutoff) alongside the DUMMY_ORDER_* flags
# documented further below. Changing any STRATEGY_ENTRY_* flag changes
# the SIMULATION page — it will NOT change any real or dummy order.
#
# NOTE: within this section three flags are FULLY DEAD — they have no
# reader at all, neither in simulation nor in order placement. They
# were removed in G1 v4.1 so operators are not misled into thinking
# they do something:
#
#     STRATEGY_ENTRY_INCLUDE_PRETOUCH
#     STRATEGY_ENTRY_ONLY_ONCE_PER_DAY
#     STRATEGY_ENTRY_FIRST_TO_CONFIRM_WINS
#
# They are still listed below (with an explicit DEPRECATED marker) only
# so an existing .env does not fail on unknown keys. Remove from your
# .env at your convenience.
# ===========================================================================
STRATEGY_ENTRY_ENABLED=true

# When True (default), evaluate CE and PE at the isolated strike
# (crossover).  When False, only the bias side (PE for S3, CE for R3)
# is considered.
STRATEGY_ENTRY_ALLOW_CROSSOVER=true

# Upper bound of the pivot_time window relative to the touch. The
# window is strictly [T_touch, T_touch + BUFFER] — never symmetric.
# A pivot that forms at 10:08 (within the buffer) confirms fast at
# 10:11 — still within the buffer, still valid.
STRATEGY_ENTRY_BUFFER_MINUTES=10

# ⚠️  DEPRECATED — removed in G1 v4.1; no reader. Setting has no effect.
# When True, allow pivots whose pivot_time is BEFORE touch_time
# (within the same buffer).  Default False — the PE 09:15 support that
# would arm on an S3 touch only exists because it is the OR low;
# including it re-opens the 84% loss the filter prevents.
STRATEGY_ENTRY_INCLUDE_PRETOUCH=false

# ⚠️  DEPRECATED — removed in G1 v4.1; no reader. Setting has no effect.
# When True (default), once a candidate side has ARMED for the day
# that side is not re-armed even if a new setup appears later.
# When False, a new confirmed support later in the day can re-arm.
STRATEGY_ENTRY_ONLY_ONCE_PER_DAY=true

# When True (default), a resistance confirmed on or before the entry
# support's confirmed_time_fast, with pivot_time strictly after the
# entry support's pivot_time and price strictly above the entry
# support's price, blocks the candidate. When False, resistance never
# blocks.
#
# NOTE: this rule is a NO-OP today (see G1 v3.2 spec §9.1). It is
# retained for forward compatibility — the auto-reverse path does not
# depend on it.
STRATEGY_ENTRY_BLOCKED_BY_RESISTANCE=true

# ⚠️  DEPRECATED — removed in G1 v4.1; no reader. Setting has no effect.
# When True (default), if both CE and PE arm on the same day, the one
# whose entry support confirmed EARLIEST (by confirmed_time_fast) wins;
# the other is discarded.
STRATEGY_ENTRY_FIRST_TO_CONFIRM_WINS=true

# ---- Auto-reverse on bias-side rejection --------------------------------
# When True (default) and the bias side confirms a fast RESISTANCE with
# NO fast SUPPORT inside the buffer window, the engine flips to the
# counter side and arms at the live LTP of the counter instrument at
# the exact instant of the bias-side rejection.
#
# Set to False to disable auto-reverse entirely (the engine then waits
# for a bias-side support or blocks at window expiry — pre-v3.2
# behaviour).
STRATEGY_ENTRY_ALLOW_AUTO_REVERSE=true

# When True (default) and BOTH a support and a resistance confirm on
# the bias side inside the window, the SUPPORT WINS and the bias side
# arms (momentum follow). When False, resistance wins and auto-reverse
# fires even when a support also confirmed.
STRATEGY_ENTRY_PRIORITIZE_SUPPORT=true

# ---- Fast entry-pivot window --------------------------------------------
# LEFT must match LIVE_SR_LEFT_BARS so the pivot bar is identical in both
# the display view and the entry view. Only the RIGHT bar count differs.
# A smaller RIGHT means faster arming. Range 1..5 recommended; higher
# values reduce noise at the cost of a slower entry.
STRATEGY_ENTRY_PIVOT_LEFT_BARS=15
STRATEGY_ENTRY_PIVOT_RIGHT_BARS=3

# ---- LTP-tier stop-loss -------------------------------------------------
# JSON array of tiers: {"max_ltp": <float|null>, "sl_pct": <0..1>}.
# Lookup is: first tier whose max_ltp is null or greater than entry_price.
# The default table gives:
#     LTP < 100            -> 15%  (e.g. entry 70 → stop 59.50)
#     100 <= LTP < 200     -> 12%  (e.g. entry 150 → stop 132.00)
#     200 <= LTP <= 300    -> 10%  (e.g. entry 280 → stop 252.00)
#     LTP > 300            -> 5%   (e.g. entry 350 → stop 332.50)
#
# Parsed defensively — bad JSON or invalid entries fall back to this
# default table (and an ERROR is logged).  The table is looked up at
# arm-time, so changes take effect on the next signal poll.
STRATEGY_ENTRY_STOP_LTP_TIERS=[{"max_ltp":100,"sl_pct":0.15},{"max_ltp":200,"sl_pct":0.12},{"max_ltp":300,"sl_pct":0.10},{"max_ltp":null,"sl_pct":0.05}]

# How to round the computed stop to a valid tick:
#   "down"      -> move the stop FURTHER from entry (wider stop)
#   "up"        -> move the stop CLOSER to entry   (tighter stop)
#   "nearest"   -> whichever tick is closest
# "down" matches the operator intent ("give me ~15% room") and errs
# on the side of not being whipsawed by noise. Only matters when the
# exact percentage lands between two ticks.
STRATEGY_ENTRY_STOP_TICK_ROUNDING=down

# Absolute maximum sl_pct any tier can yield. Tiers whose sl_pct
# exceeds this cap are clamped and an ERROR is logged.
STRATEGY_MAX_STOP_PCT=0.35

# ---- Promotion (DORMANT after the 2026-11-02 order-strategy rewrite) ----
# When the entry-signal ARMS on the COUNTER side (either via crossover
# or via auto-reverse), promote that instrument to be the active
# isolated instrument for the rest of the day.
#
# The isolation record itself is never modified — the original trigger
# (bias-side) instrument stays in the record and in the trigger_event
# for audit. The promotion is stored in a separate sidecar file:
#
#   data/level_isolated_instrument_promotion.json
#
# NOTE: the promotion service is DORMANT — no code path calls
# apply_promotion() after the 2026-11-02 rewrite. These two flags are
# kept for backward compatibility with the promotion module itself;
# they have no runtime effect on order placement.
STRATEGY_ENTRY_ALLOW_PROMOTION=true

# When True, a second promotion may override the first.  Default False
# — the first ARMED side wins and the pick is stable for the day.
# Ignored when ALLOW_PROMOTION is False.
STRATEGY_ENTRY_ALLOW_RE_PROMOTION=false

# ===========================================================================
# SIMULATION — post-close dummy-order replay for the isolated instrument
# ===========================================================================
# The simulation service replays the isolated instrument's day using
# the authoritative intraday 1-min candles. It builds TWO scenarios
# side by side so the operator can compare the strategy signal's own
# target with the regime-based target computed from the option's own
# OR levels:
#
#   A) "signal_v2"  — the target and stop that the strategy entry
#                     signal produced (nearest resistance above entry
#                     for the target; LTP-tier stop for the stop).
#
#   B) "regime"     — the target and stop picked by the simulation's
#                     regime classifier, using the option's own OR
#                     levels H, L, A, R1, R2, R3, S1, S2, S3.
#
# Endpoint (POST-only, stateless): POST /admin/simulation/run
# ===========================================================================
SIMULATION_ENABLED=true
SIMULATION_USE_REGIME_TARGETS=true

# HIGH / HIGH_EXTREME regime stop mode:
#   "tier"     -> LTP-tier stop only
#   "range"    -> OR half-range only: E − (A − L)
#   "tighter"  -> min(tier, range) — default
SIMULATION_STOP_MODE_HIGH=tighter

# When target and stop are BOTH inside the same 1-min bar's [low, high]
# range, which hit first? Default True (conservative — assume stop).
SIMULATION_SAME_BAR_STOP_FIRST=true

# Tick rounding for the target and stop prices. "nearest" / "down" / "up".
SIMULATION_TICK_ROUNDING=nearest

# ===========================================================================
# DUMMY ORDERS — deterministic post-isolation execution
# (t_feed_v1-market-engine-v3)
# ===========================================================================
# ⚠️  DETERMINISM CONTRACT
# ------------------------
# The same trading day, the same isolation record, and the same intraday-
# API response MUST produce the SAME set of dummy orders, regardless of
# the process start time (09:20 IST live vs. 14:16 IST restart vs. 20:00
# IST post-close replay).
#
# To satisfy this contract, services/dummy_order_service.py:
#   * reads ALL entry / stop / target data from the FROZEN replay series
#     built once by the startup SR backfill (the every-2-minute
#     LIVE_SR_REFRESH_FROM_API_* tick only touches the live buffer,
#     never the replay series — see services/scheduler_service.py);
#   * will NOT create an order until
#     sr_backfill_service.is_ready_for_today() returns True — the same
#     latch consumed by main.py and by scheduler_service._dummy_order_tick
#     (any other tick that reaches this service must consult the same
#     latch);
#   * will NOT overwrite an existing stored entry when a later catch-up
#     recomputation derives a different one (DUMMY_ORDER_DRIFT_GUARD).
#
# Every record is labelled "dummy" — no real Upstox order is ever placed
# by this service.
#
# Order placement is driven entirely by these DUMMY_ORDER_* flags plus
# the STRATEGY_ORDER_* block in core/config.py (stop-loss, milestone
# gain, reversal cutoff). NOT by the STRATEGY_ENTRY_* flags — those
# affect only /simulation (see the SIMULATION-ONLY banner above).
#
# Persistence: <LIVE_DATA_DIR>/<DUMMY_ORDER_FILENAME>
# ===========================================================================
DUMMY_ORDER_ENABLED=true
DUMMY_ORDER_TRACK_INTERVAL_SECONDS=30
DUMMY_ORDER_START_HOUR=9
DUMMY_ORDER_START_MINUTE=15
DUMMY_ORDER_EOD_HOUR=15
DUMMY_ORDER_EOD_MINUTE=35
DUMMY_ORDER_FILENAME=dummy_orders.json
DUMMY_ORDER_TELEGRAM_ENABLED=false

# ---- Determinism guards (2026-11-04) ------------------------------------
# Six flags make the post-isolation execution pipeline auditable and
# force deterministic replay when the SR backfill is incomplete. All
# default to the safe deterministic behaviour — no .env change is
# required.

# When true, the service MAY fall back to live LTP when no deterministic
# SR-based entry price can be resolved. Restores the pre-2026-11-04
# behaviour and is INTENDED FOR DEBUGGING ONLY — it undermines
# reproducibility. Must be false when STRICT_DETERMINISTIC_REPLAY is
# true; the startup config validator
# (services/config_validation.py) rejects the combination.
# Default: false.
DUMMY_ORDER_ALLOW_LTP_ENTRY_FALLBACK=false

# When true (recommended), unresolved entries are SKIPPED — never
# substituted with live LTP. Primary "deterministic by default" switch.
# Takes precedence over ALLOW_LTP_ENTRY_FALLBACK at runtime.
# Default: true.
DUMMY_ORDER_STRICT_DETERMINISTIC_REPLAY=true

# When true (recommended), dummy_order_service.run_once() waits for the
# SR backfill to complete before attempting the first post-isolation
# trigger. Prevents a mid-day restart racing into an incomplete SR state
# (the 14:16-on-2026-10-29 bug class). The scheduler's _dummy_order_tick
# additionally short-circuits on the same latch; this flag governs the
# service-internal wait as well. The startup config validator emits a
# WARNING when this is false.
# Default: true.
DUMMY_ORDER_WAIT_FOR_SR_BACKFILL=true

# Hard cap on the wait above, in seconds. If the backfill is not complete
# within this window the tick is skipped and the next tick retries. Only
# meaningful when DUMMY_ORDER_WAIT_FOR_SR_BACKFILL=true.
# Default: 120.
DUMMY_ORDER_WAIT_FOR_SR_BACKFILL_TIMEOUT_SECONDS=120

# When true (recommended), the Path A / Path B code path is derived SOLELY
# from the isolation record's trigger_index (MIDCPNIFTY → Path B,
# everything else → Path A). The runtime override (env-driven path
# switching) is disabled, so replay is a pure function of the isolation
# record. Must be true for the determinism contract to hold. The startup
# config validator emits a WARNING when this is false.
# Default: true.
DUMMY_ORDER_DISABLE_RUNTIME_PATH_SWITCH=true

# When true (recommended), an existing stored entry must NOT be overwritten
# by a later catch-up recomputation. A WARNING is logged and the original
# entry is retained. Prevents silent drift when the service restarts
# mid-day and re-derives an entry from a different candle window. Must be
# true for the determinism contract to hold.
# Default: true.
DUMMY_ORDER_DRIFT_GUARD=true

# ---- DEPRECATED (post 2026-11-02 order-strategy rewrite) ----------------
# The following keys are SILENTLY IGNORED by services/dummy_order_service.py
# after the 2026-11-02 rewrite. They were removed because they were only
# consumed by the removed Path A / Path B logic. Listed here only so an
# existing .env does not raise surprises when these lines are present:
#
#   DUMMY_ORDER_RECONCILE_MINUTES=2         (old LTP + bar reconcile cadence)
#   DUMMY_ORDER_CREATE_REGIME_VARIANT=true  (Path A scenario variants)
#   DUMMY_ORDER_MAX_ORDERS_PER_DAY=100      (Path A / Path B order cap)

# ===========================================================================
# SANDBOX EXECUTION — live sandbox order mirror of dummy-order transitions
# ===========================================================================
# ⚠️  DETERMINISM CONTRACT SAFETY
# --------------------------------
# The sandbox reads data/dummy_orders.json state via the dummy-order
# service's post-persistence transition callback. It NEVER writes to
# dummy_orders.json — sandbox state lives in a SEPARATE ledger
# (SANDBOX_LEDGER_PATH) so the determinism contract above and
# DUMMY_ORDER_DRIFT_GUARD remain untouched.
#
# WHAT THE SANDBOX DOES
# ---------------------
# services/sandbox_execution_service.py (2026-11-04) consumes the dummy
# service's transition callback (set_transition_callback) and mirrors
# each transition onto a real broker order — but ONLY when EVERY gate
# below passes. In gate order:
#
#     1. reason == "scheduled"            (startup catch-up is ignored)
#     2. SANDBOX_EXECUTION_ENABLED        (this block, default false)
#     3. SANDBOX_EXECUTION_MODE == "live" (this block, default "observe")
#     4. order_runtime_service.status()["enabled"] == True
#        (POST /admin/orders/runtime-enable / runtime-disable)
#     5. sr_backfill_service.is_ready_for_today() == True
#     6. current time is inside [09:15, 15:15] IST
#     7. ledger idempotency key has not already fired
#     8. single-position lock is free
#
# All eight must pass. Any single failure logs a gate decision and
# returns without placing anything.
#
# TRANSLATION TABLE
# -----------------
#     dummy transition                → sandbox action
#     --------------------------------→--------------------------------
#     CREATED                         → place_order(BUY, MARKET, product=D)
#     STAGE_2_MILESTONE               → log only (no broker action)
#     STOP_HIT                        → exit_all_positions(dry_run=False)
#     STAGE_2_RESISTANCE_EXIT         → exit_all_positions(dry_run=False)
#     NEXT_15_3_RESISTANCE_EXIT       → exit_all_positions(dry_run=False)
#     EOD_CLOSE                       → exit_all_positions(dry_run=False),
#                                       unless already exited at 15:15
#
# TWO ENGINEERED DIVERGENCES FROM THE DUMMY ENGINE
# ------------------------------------------------
#   (Bug A) Stop-loss latency.
#     Dummy STOP_HIT is detected on the 30 s scheduler tick. Mirrored as
#     exit_all, the effective stop is a 30 s-latency market exit, not a
#     resting SL order. Accepted for v1 — the executor records
#     entry/exit_latency_ms and fill_slippage_pct on every transition
#     so the divergence can be quantified before deciding whether to
#     add a resting SL-M order later.
#
#   (Bug B) EOD ownership.
#     The dummy engine closes at DUMMY_ORDER_EOD_HOUR:MINUTE (default
#     15:35). That is TOO LATE for real execution — the broker
#     auto-squares-off intraday F&O positions ~15:15-15:25 IST. So the
#     sandbox runs its OWN EOD at SANDBOX_EOD_HOUR:SANDBOX_EOD_MINUTE
#     (default 15:15) via the sandbox_eod_exit scheduler job. The later
#     15:35 dummy EOD_CLOSE then falls into the executor's "already
#     exited" no-op branch and is logged as the expected divergence
#     between the two engines.
#
# DEFAULT DEPLOYMENT IS INERT
# ---------------------------
# SANDBOX_EXECUTION_ENABLED=false + SANDBOX_EXECUTION_MODE=observe means
# the executor evaluates every gate, logs every decision, and makes
# ZERO broker calls. To actually place live sandbox orders you must
# BOTH flip the env gate below AND call POST /admin/orders/runtime-enable
# after startup — one switch cannot override the other. That is
# deliberate; see the kill-switch note in routes/admin_orders.py.
#
# ROLLOUT RECOMMENDATION
# ----------------------
#   1. Ship with SANDBOX_EXECUTION_ENABLED=false (observe off entirely).
#   2. Flip SANDBOX_EXECUTION_ENABLED=true, keep MODE=observe. Run 3-5
#      sessions; grep logs for "[sandbox_exec] skip" and "[sandbox_exec]
#      OBSERVE" — the OBSERVE lines must mirror dummy_orders.json 1:1.
#   3. Flip SANDBOX_EXECUTION_MODE=live, keep SANDBOX_LOTS=1. POST
#      /admin/orders/runtime-enable. Monitor /admin/orders/sandbox-status
#      for pause/exit_stuck and the latency histogram.
#   4. Only after the latency data (Bug A) has been reviewed, consider
#      raising SANDBOX_LOTS or adding a resting SL-M order.
# ===========================================================================

# Master gate for live sandbox execution.
#
# false (default) — the executor evaluates no gates and places no orders.
#                   Startup logs will NOT show a "[sandbox_exec]" line.
# true            — the executor evaluates all eight gates. Whether any
#                   order is placed depends on MODE and the runtime
#                   toggle (see below).
#
# This is the deployment-level opt-in. It should only be true on a box
# where an operator has explicitly decided to run live sandbox execution.
SANDBOX_EXECUTION_ENABLED=false

# Execution mode:
#
#   "observe" (default) — evaluate every gate, log every decision,
#                         place NO broker orders. The ledger is written
#                         with OBSERVE-marked rows so the decision trail
#                         is preserved. Use this for the first 3-5
#                         sessions to verify the 1:1 transition mapping
#                         against dummy_orders.json.
#
#   "live"              — place real orders through place_order /
#                         exit_all_positions. Requires SANDBOX_EXECUTION_ENABLED=true
#                         AND POST /admin/orders/runtime-enable. Both
#                         gates must be satisfied.
#
# Any other value is normalised to "observe" by the executor (defensive
# against typos in .env). The unknown value is logged at WARNING.
SANDBOX_EXECUTION_MODE=observe

# Number of lots per sandbox entry. The place_order call takes this many
# lots of the option contract (product="D" intraday). For test
# deployments use 1 — you do NOT want to discover the notional of one
# MIDCPNIFTY lot with real money. Increase only after a clean live run
# and a P&L reconciliation against the dummy engine.
SANDBOX_LOTS=1

# Sandbox-owned end-of-day exit (Bug B fix). Fired by the
# sandbox_eod_exit scheduler job in services/scheduler_service.py.
#
# MUST be strictly EARLIER than both:
#   * the broker's intraday auto-square-off window (~15:15-15:25 IST),
#   * DUMMY_ORDER_EOD_HOUR:DUMMY_ORDER_EOD_MINUTE (default 15:35).
#
# Default 15:15 matches the observed broker cut-off on the current
# account. If your broker auto-squares-off at a different time, push
# these back by the same margin (e.g. 15:10 for a 15:12 cut-off) —
# DO NOT leave them at 15:15 if the cut-off is later.
SANDBOX_EOD_HOUR=15
SANDBOX_EOD_MINUTE=15

# Persistence path for the sandbox ledger.
#
# Separate file from data/dummy_orders.json — the dummy state is governed
# by the determinism contract and DUMMY_ORDER_DRIFT_GUARD, and mixing
# sandbox state into it would violate both. The executor writes to this
# path and never touches dummy_orders.json.
#
# Relative paths are resolved by the executor (which anchors to the
# process cwd). Absolute paths are used verbatim. Back this file up
# alongside data/dummy_orders.json — it is the audit trail of every
# real order the sandbox has ever placed.
SANDBOX_LEDGER_PATH=data/sandbox_orders.json

# Retry policy for exit_all failures. On each failure the executor waits
# SANDBOX_EXIT_RETRY_BACKOFF_SECONDS * attempt (attempt=1,2,...) then
# retries. After SANDBOX_EXIT_RETRY_ATTEMPTS consecutive failures the
# executor sets sandbox_exit_stuck=true, blocks all new entries, and
# surfaces the state on /admin/orders/sandbox-status.
#
# Recovery from exit_stuck is MANUAL: verify via
# GET /admin/orders/exit-all?dry_run=true that the position is gone,
# exit it manually if not, then restart the process. Do not add a
# one-click resume — that would risk a phantom position on the broker
# while the ledger thinks it was closed.
SANDBOX_EXIT_RETRY_ATTEMPTS=3
SANDBOX_EXIT_RETRY_BACKOFF_SECONDS=1.5

# Entry-fill confirmation polling. After place_order returns ok, the
# executor polls get_order_details every SANDBOX_FILL_POLL_SECONDS until
# filled_quantity > 0 or SANDBOX_FILL_TIMEOUT_SECONDS elapses. The
# entry is only marked ENTERED after a confirmed fill; timeout →
# ENTRY_FAILED (no phantom exit will be scheduled, the ledger records
# the failure with the raw broker response).
#
# FILL_TIMEOUT_SECONDS: how long to wait before declaring the entry
#                       failed. 15 s is generous for a MARKET order;
#                       reduce only if Upstox's response time improves.
# FILL_POLL_SECONDS:    how often to poll. 1 s is the sweet spot —
#                       faster hits rate limits, slower adds latency
#                       to the ENTERED timestamp (which is what the
#                       latency histogram records).
SANDBOX_FILL_TIMEOUT_SECONDS=15.0
SANDBOX_FILL_POLL_SECONDS=1.0

# When true (default), the sandbox executor appends its own Telegram
# messages on each action (placed / exited / failed / skipped-by-gate).
# Same channel as DUMMY_ORDER_TELEGRAM_ENABLED so operators see the two
# engines side by side in one place. Set to false only when debugging
# local broker calls — the audit trail is more valuable than silence.
SANDBOX_TELEGRAM_ENABLED=false

# ===========================================================================
# G1 v4.1 FIXES — /isolated page analysis (2026-10-29)
# ===========================================================================
# NOTE (2026-11-04): the STRATEGY_ENTRY_* flags in this block are
# covered by the SIMULATION-ONLY banner in the STRATEGY ENTRY SIGNAL
# section above. They feed /simulation diagnostics, NOT order placement.
# LEVEL_ISOLATION_* flags DO affect the isolation record itself and are
# therefore part of the deterministic replay inputs.
#
# Six independent kill switches, each tied to one fix from the
# `/isolated page against G1 v4.0` analysis. ALL default to true
# (fixed behaviour); no .env change is required to gain the fixes.
#
# Each flag exists so an operator can disable a single change in
# isolation without reverting the whole v4.1 bundle — useful for
# bisecting a regression in the field.
#
# To disable ONE fix in place, add e.g. `STRATEGY_ENTRY_CANDLE_FALLBACK_ENABLED=false`
# to .env and restart. The other five remain active.
#
# --- §5.A — both-sides registration -------------------------------------
# When true (default) and STRATEGY_ENTRY_ALLOW_CROSSOVER is also true,
# _isolate() registers BOTH the bias-side and counter-side instruments
# with live_sr_levels_service immediately after strike resolution, and
# includes both sides' candidates (tagged side: "bias" | "counter") in
# event["candidates"].
#
# Why it matters: without this registration the counter-side entry
# price lookup in _entry_price_for() cannot find the confirming candle,
# falls back to live LTP, and freezes a wrong entry. On the analysis
# session this produced PE entry 61.65 (the 15:31 LTP) when the 09:23
# candle close was 186.55 — a −67% error that propagates into stop,
# target, and dummy-order R-multiple.
#
# Also makes the "Candidates considered" table show the true count
# (4, not 2) when crossover is enabled (§5.F in the template).
STRATEGY_ENTRY_REGISTER_COUNTER_SIDE=true

# --- §5.B — stateless-calc candle fallback ------------------------------
# When true (default), _entry_price_for() falls through to
# live_sr_calc_service.get_candle_close_at() when the fast path
# (live_sr_levels_service._states[key]["candles"]) cannot resolve the
# confirming minute. That helper merges historical + intraday candles
# directly from the Upstox API and is guaranteed to have the confirming
# bar even in simulate mode.
#
# Effect: entry prices are historical candle closes, not the current
# wall-clock LTP. The price_source field on the entry record reads
# "candle_close_at_confirmed_fast" when this works; a "live_ltp" value
# with this flag true means both candle lookups failed and warrants
# investigation (the /isolated template surfaces this as a warning).
STRATEGY_ENTRY_CANDLE_FALLBACK_ENABLED=true

# --- §5.C — target must be confirmed after entry -------------------------
# When true (default), the target resistance must satisfy
# r.confirmed_time_fast > entry_support.confirmed_time_fast in addition
# to r.price > entry_price. Without this the target silently becomes
# the most recent resistance (typically the lowest on a down day)
# instead of the first one confirmed after entry — the analysis caught
# a target of 63.00 (a 15:24 resistance) instead of 110.65 (a 10:56
# resistance confirmed after the 09:23 entry).
STRATEGY_ENTRY_TARGET_REQUIRE_POST_ENTRY=true

# --- §5.D (1/2) — replay OR from the same series ------------------------
# When true (default), _replay() recomputes OR levels from the same
# candle series it is iterating (via first_candle_service.compute_for_series)
# instead of trusting the on-disk first_candle.json. This is the
# primary fix for the phantom MIDCPNIFTY R3 touch (trigger_ltp
# 13310.60 < R3 13329.65 with OR-H 13298.75 — mutually exclusive facts
# that can only happen when OR and candles come from different series).
LEVEL_ISOLATION_REPLAY_USE_SERIES_OR=true

# --- §5.D (2/2) — self-heal verifies OR file H/L ------------------------
# When true (default), _maybe_self_heal() additionally compares the
# cached OR file's first_candle H / L against today's real first
# intraday bar (via live_sr_calc_service.get_first_intraday_candle) and
# forces a TARGETED recompute on mismatch. Catches the "stale-but-
# today-dated" case the existing missing-file / stale-date check does
# not catch. Cheap: 1 index fetch + (worst case) 1–2 option recomputes,
# not the full ~100-instrument registry sweep.
LEVEL_ISOLATION_OR_SELF_HEAL_VERIFY_HL=true

# --- §5.E — freeze the entry block on promotion -------------------------
# When true (default), isolated_instrument_promotion_service.apply_promotion()
# writes frozen_entry = {price, price_source, stop, target, time, frozen_at}
# onto the promotion record at the moment the winning side is armed, and
# returns it on the result dict. The /isolated template reads this block
# from /strategy-signal and /detail so the entry card pins the settled
# values instead of drifting on every 10 s poll.
#
# When false, the promotion record is written as before (no frozen_entry)
# and the template falls back to the live-computed path — reproducing
# the pre-v4.1 drift symptom. Use only to bisect a regression; leave
# true in production.
STRATEGY_ENTRY_FREEZE_ENTRY_ON_PROMOTION=true

# ===========================================================================
# ⚠️  DEPRECATED — G1 v4.1 PATH B / MULTI-ORDER SR WATCH (2026-11-02)
# ===========================================================================
# The Path B code path was REMOVED in the 2026-11-02 order-strategy
# rewrite. Path selection is now derived PURELY from the isolation
# record's trigger_index (see DUMMY_ORDER_DISABLE_RUNTIME_PATH_SWITCH
# in the DUMMY ORDERS section above). Every STRATEGY_EXT_* key below is
# SILENTLY IGNORED by the current services/dummy_order_service.py.
#
# Retained only so an existing .env does not raise "unknown key"
# surprises. Remove from your .env at your convenience.
# ===========================================================================

# Master switch for Path B. DEPRECATED — has no effect.
STRATEGY_EXT_PATH_B_ENABLED=true

# Underlyings that generate executable dummy orders on Path B.
# DEPRECATED — has no effect.
STRATEGY_EXT_TRACKED_UNDERLYINGS=NIFTY,SENSEX

# Lot sizes used by the Rupee profit calculation.
# DEPRECATED — has no effect.
STRATEGY_EXT_LOT_SIZE_NIFTY=65
STRATEGY_EXT_LOT_SIZE_SENSEX=20

# Rupee-based profit trailing.
#   peak_profit_rs >= ACTIVATION_RS              -> switch to TRAILING
#   trail = Entry + (peak_profit_rs - TRAIL_GAP_RS) / lot_size
#   floor = TRAIL_FLOOR_RS worth of locked profit
# DEPRECATED — has no effect.
STRATEGY_EXT_PROFIT_ACTIVATION_RS=1000
STRATEGY_EXT_TRAIL_GAP_RS=500
STRATEGY_EXT_TRAIL_FLOOR_RS=1000

# Alternate trailing activation: entry < R2 and LTP >= R3.
# DEPRECATED — has no effect.
STRATEGY_EXT_R3_BREAKOUT_ACTIVATION_ENABLED=true

# Bearish-regime exit while in TRAILING mode.
# DEPRECATED — has no effect.
STRATEGY_EXT_BEARISH_EXIT_ENABLED=true
STRATEGY_EXT_BEARISH_CANDLES=2

# Lock the day (no new SR orders) when any Path B trade hits target.
# DEPRECATED — has no effect.
STRATEGY_EXT_LOCKDOWN_ON_TARGET=true

# Polling cadence for the multi-index boundary watch.
# DEPRECATED — has no effect.
STRATEGY_TOUCH_POLL_INTERVAL_SEC=2.0

# ===========================================================================
# ADMIN / API AUTHENTICATION
# ===========================================================================
# Shared secret for machine clients. Send as:
#     X-API-Key: <value>
#   or
#     Authorization: Bearer <value>
# Leave empty to disable.
ADMIN_API_KEY=

# HTTP Basic creds for humans opening /docs, /logs, /admin in a browser.
# Leave ADMIN_BASIC_PASSWORD empty to disable Basic auth.
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=

# CORS origins. "*" is only safe for a local, isolated box.
# In production list your real UI origins, comma-separated.
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# External EMA V2 Support / Resistance WebSocket
# S/R pivots are calculated by EMA V2; this app only consumes the stream.
# ---------------------------------------------------------------------------
EXTERNAL_SR_WS_ENABLED=true
EXTERNAL_SR_WS_URL=wss://ema.novag7.in
EXTERNAL_SR_STALE_SECONDS=180
# Legacy local pivot calculation/backfill is intentionally disabled in code.


# ===========================================================================
# MARKET ENGINE V5 — MEMBER ACCOUNTS (separate identity database)
# ===========================================================================
# Member identities are isolated from trading/token data. The existing
# MONGO_URL / MONGO_URI connection is reused, but a separate database and
# collections are selected here.
USER_AUTH_MONGO_DB=MARKET_ENGINE_IDENTITY
USER_AUTH_USERS_COLLECTION=users
USER_AUTH_AUDIT_COLLECTION=auth_audit
USER_AUTH_COOKIE_NAME=market_member
USER_AUTH_SESSION_TTL_SECONDS=28800
USER_AUTH_MAX_FAILED_LOGINS=3
USER_AUTH_LOCK_MINUTES=120
# Sends a registration alert to TELEGRAM_CHAT_ID independently of TELEGRAM_ENABLED.
USER_REGISTRATION_TELEGRAM_ENABLED=true
# Generate a unique secret (48+ random bytes recommended):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
USER_AUTH_SESSION_SECRET=<unique-random-secret-at-least-32-characters>


# ===========================================================================
# MARKET ENGINE V5 — PROFESSIONAL PLATFORM PROFILE
# ===========================================================================
# V5 disables outbound Telegram notifications and the Telegram polling bot.
# Scheduled MEGA archive backups are disabled. Historical candle extraction
# used by the chart/startup pipeline remains enabled.
V5_QUIET_LOGS=true
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN_BOT_ENABLED=false
DAILY_BACKUP_ENABLED=false
MEGA_ENABLED=false
LEVEL_ISOLATION_TELEGRAM_ENABLED=false
LEVEL_ISOLATION_SR_TELEGRAM_ENABLED=false
DUMMY_ORDER_TELEGRAM_ENABLED=false
SANDBOX_TELEGRAM_ENABLED=false
