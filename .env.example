# .env.example

# App
APP_NAME=orderflow
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8003

# ============================================================
# MongoDB
# ============================================================
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=ISOLATION_CONSUMER
ISOLATION_EVENTS_COLLECTION=isolation_events
DAILY_DATA_BACKUP_COLLECTION=daily_data_backup_state

# ============================================================
# Local SR / Supertrend state
# ============================================================
SR_STATE_DIR=./data/sr_state
SR_STORE_HEARTBEATS=false
SUPERTREND_ENABLED=true
SUPERTREND_STATE_DIR=./data/supertrend_state

# Local Upstox HistoryV3 Supertrend recovery and live calculation.
SUPERTREND_HISTORY_DAYS=10
SUPERTREND_ATR_PERIOD=10
SUPERTREND_MULTIPLIER=3.0
SUPERTREND_CHANGE_ATR=true
SUPERTREND_POLL_SECONDS=15
SUPERTREND_RECOVERY_BUFFER_SECONDS=300
SUPERTREND_FETCH_TIMEOUT_SECONDS=25
DATA_DIR=./data

# ============================================================
# Upstream SR feed
# ============================================================
SR_WS_BASE_URL=wss://ema.novag7.in
SR_WS_BASE_URL_LOCAL=
SR_WS_DEFAULT_CONFIG=all
SR_WS_KEEPALIVE_SECONDS=30
SR_WS_RECONNECT_MAX_BACKOFF_SECONDS=30

# ============================================================
# Shared local live-market feed
# One connection for isolated option, opposite option and NIFTY 50.
# ============================================================
LIVE_FEED_ENABLED=true
LIVE_FEED_WS_URL=
LIVE_FEED_PORT=8010
LIVE_FEED_MODE=full
LIVE_FEED_SAVE_RAW=true
LIVE_FEED_STATE_DIR=./data/live_feed
LIVE_FEED_START_HOUR=9
LIVE_FEED_START_MINUTE=15
LIVE_FEED_END_HOUR=15
LIVE_FEED_END_MINUTE=30
LIVE_FEED_RECONNECT_MAX_BACKOFF_SECONDS=30

# Optional comma-separated NSE trading holidays (IST dates, YYYY-MM-DD)
MARKET_HOLIDAYS=
NIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty 50

# ============================================================
# Dummy order simulation (local only; no broker execution)
# ============================================================
DUMMY_ORDERS_ENABLED=true
DUMMY_SUPERTREND_ORDERS_ENABLED=true
DUMMY_ORDER_QUANTITY=1
DUMMY_ORDER_STATE_DIR=./data/dummy_orders
DUMMY_ORDER_STOP_LOSS_PERCENT=30
# BUY target points: entry > 200 => 60; 100 <= entry <= 200 => 50; entry < 100 => 40
DUMMY_TARGET_UPPER_THRESHOLD=200
DUMMY_TARGET_LOWER_THRESHOLD=100
DUMMY_TARGET_POINTS_ABOVE_UPPER=60
DUMMY_TARGET_POINTS_MIDDLE=50
DUMMY_TARGET_POINTS_BELOW_LOWER=40
# Mongo collection is fixed as MONGO_DATABASE.dummy_orders

# Optional live GTT submission (server-to-server; OFF by default)
GTT_ORDERS_ENABLED=false
GTT_API_URL=https://sandbox.novag7.in/api/external/v1/gtt/place
GTT_API_TOKEN=
GTT_PRODUCT=I
GTT_REQUEST_TIMEOUT_SECONDS=12
# Mandatory live-execution freshness limits (IST)
GTT_MAX_SIGNAL_AGE_SECONDS=60
GTT_MAX_QUOTE_AGE_SECONDS=10
GTT_LIVE_FRAME_MAX_AGE_SECONDS=5

# ============================================================
# MEGA daily data archive
# Remote path: orderflow/YYYYMMDD_data.zip
# Scheduled after the live-feed collection window (default 16:05 IST).
# ============================================================
DAILY_DATA_BACKUP_ENABLED=true
DAILY_DATA_BACKUP_DIR=./backups
DAILY_DATA_BACKUP_HOUR=16
DAILY_DATA_BACKUP_MINUTE=5
DAILY_DATA_BACKUP_DAYS=mon-fri
DAILY_DATA_BACKUP_COLLECTION=daily_data_backup_state

MEGA_ENABLED=true
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_BACKUP_ROOT=orderflow

# ============================================================
# Inbound auth
# ============================================================
ISOLATION_NOTIFY_CLIENT_KEY=
ISOLATION_NOTIFY_CLIENT_KEY_HEADER=X-Isolation-Key
REQUIRE_TODAY_ONLY_SCOPE=true

# ============================================================
# Telegram notifications
# ============================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOGS_DIR=./logs
VERBOSE=false
