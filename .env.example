# .env.example

# App
APP_NAME=isolation_consumer_service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8003

# ============================================================
# MongoDB — isolation documents only
# ============================================================
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=ISOLATION_CONSUMER
ISOLATION_EVENTS_COLLECTION=isolation_events

# ============================================================
# Local SR state (filesystem, NOT Mongo)
# One JSON file per (instrument_key, config) under SR_STATE_DIR.
# ============================================================
SR_STATE_DIR=./data/sr_state
SR_STORE_HEARTBEATS=false

# Local Supertrend state for isolated/opposite leg WebSocket feeds.
SUPERTREND_STATE_DIR=./data/supertrend_state

# Local JSON mirror of every isolation document (empty → disabled).
DATA_DIR=./data

# ============================================================
# Upstream SR feed (app1)
# ============================================================
SR_WS_BASE_URL=wss://ema.novag7.in
SR_WS_BASE_URL_LOCAL=
SR_WS_DEFAULT_CONFIG=all
SR_WS_KEEPALIVE_SECONDS=30
SR_WS_RECONNECT_MAX_BACKOFF_SECONDS=30

# Inbound auth (must match app1's ISOLATION_NOTIFY_CLIENT_KEY)
ISOLATION_NOTIFY_CLIENT_KEY=
ISOLATION_NOTIFY_CLIENT_KEY_HEADER=X-Isolation-Key

# Today-only scope enforcement
REQUIRE_TODAY_ONLY_SCOPE=true

# ============================================================
# Verbose logging
# false → connection_ack / snapshot / sr_update are logged at DEBUG
# true  → those frames are logged at INFO
# ============================================================
VERBOSE=false

# Optional Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOGS_DIR=./logs