[Unit]
Description=FastAPI Telegram Project Update Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/project_update_service
EnvironmentFile=/home/ubuntu/project_update_service/.env
ExecStart=/home/ubuntu/project_update_service/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
