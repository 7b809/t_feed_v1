APP_NAME=Upstox Order Management API
APP_HOST=127.0.0.1
APP_PORT=8010
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data

UPSTOX_ACCESS_TOKEN=
UPSTOX_ORDER_API_VERSION=v3
UPSTOX_API_VERSION=2.0

# Leave disabled until explicitly tested and approved.
TRADING_ENABLED=false
DEFAULT_TRANSACTION_TYPE=BUY
DEFAULT_QUANTITY=65
DEFAULT_ORDER_TYPE=MARKET
DEFAULT_PRODUCT=I
DEFAULT_VALIDITY=DAY
DEFAULT_MARKET_PROTECTION=-1

MONGO_URL=
MONGO_DATABASE=UPSTOX_APP_V2
MONGO_ORDERS_COLLECTION=sandbox_orders
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
