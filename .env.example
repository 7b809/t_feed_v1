# Copy this file to .env and replace required values and enabled-service
# credentials. The Upstox access token is read from MongoDB, not from an env var.

# ============================================================
# SERVICE CONTROL / APPLICATION
# ============================================================
SERVICE_CONTROL_ENABLED=false
# Required only when SERVICE_CONTROL_ENABLED=true.
SERVICE_CONTROL_TOKEN=
SERVICE_MANAGER=internal
SYSTEMD_SERVICE_NAME=option-feed-engine
REDEPLOY_COMMAND=
SERVICE_COMMAND_TIMEOUT_SECONDS=120

# ============================================================
# MONGODB (required)
# ============================================================
# Replace all three required placeholders with your MongoDB settings.
MONGO_URL=your_mongodb_connection_uri
MONGO_DB=your_mongodb_database_name
TOKENS_COLLECTION=your_tokens_collection_name
UPSTOX_TOKEN_DOC_ID=upstox_access_token

# Mongo-backed runtime configuration and audit history.
RUNTIME_CONFIG_ENABLED=true
RUNTIME_CONFIG_COLLECTION=runtime_configs
RUNTIME_CONFIG_AUDIT_COLLECTION=runtime_config_audit
RUNTIME_CONFIG_CACHE_ENABLED=true
RUNTIME_CONFIG_FAIL_OPEN=true
RUNTIME_CONFIG_AUDIT_ENABLED=true
RUNTIME_CONFIG_MAX_AUDIT_RECORDS=5000

# Isolated-instrument event persistence.
ISOLATED_INSTRUMENT_EVENT_ENABLED=true
ISOLATED_INSTRUMENT_EVENT_COLLECTION=isolated_instrumentevent
ISOLATED_INSTRUMENT_EVENT_FIELD_NAME=events
ISOLATED_INSTRUMENT_EVENT_FAIL_OPEN=true
ISOLATED_INSTRUMENT_EVENT_INCLUDE_SIMULATION=true
ISOLATED_INSTRUMENT_EVENT_INCLUDE_DRY_RUN=true

# Order result persistence and order behavior.
UPSTOX_ORDER_COLLECTION=upstox_orders
UPSTOX_ORDER_ENABLED=true
# Code default is true; keep disabled in this starter file until explicitly reviewed.
PLACE_ORDER=false
DUMMY_ORDERS=false
SELL_EXIT=true

# ============================================================
# UPSTOX TOKEN AND MARKET
# ============================================================
# Store the active access_token in the MongoDB token document above.
# This project does not read UPSTOX_ACCESS_TOKEN or OAuth client credentials
# from the environment.
UPSTOX_TOKEN_CHECK_INTERVAL_MINUTES=30
REFRESH_INTERVAL_MINUTES=60
WEBSOCKET_FEED_MODE=full

# ============================================================
# MARKET TIME AND OPTION CONTRACT SELECTION
# ============================================================
MARKET_TIMEZONE=Asia/Kolkata
MARKET_TIME_FORMAT=%Y-%m-%d %H:%M:%S %Z
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
MAIN_NIFTY_SECURITY=NSE_INDEX|Nifty 50
STRIKE_FROM=23000
STRIKE_TO=25000

# ============================================================
# HISTORICAL CANDLES AND EMA
# ============================================================
HISTORICAL_CANDLE_ENABLED=true
HISTORICAL_CANDLE_DAYS=10
HISTORICAL_CANDLE_INTERVAL=1minute
HISTORICAL_CANDLE_API_VERSION=2.0
HISTORICAL_CANDLE_MAX_DAYS_PER_REQUEST=7
HISTORICAL_CANDLE_OUTPUT_DIR=data/historical_candles
HISTORICAL_CANDLE_MAX_WORKERS=8
HISTORICAL_CANDLE_REQUEST_SLEEP_SECONDS=0.15

# Internal completed-candle EMA engine. 1-minute polling runs through the
# existing scheduler (10-second scheduler cadence); the engine processes a
# maximum of one completed-candle batch per market minute.
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
LIVE_EMA_ENABLED=true
LIVE_EMA_CALCULATION_MODE=false
LIVE_EMA_INTERVAL_MINUTES=1
LIVE_EMA_FAST_PERIOD=9
LIVE_EMA_SLOW_PERIOD=21
LIVE_EMA_TICK_ALERT_ONCE_PER_DIRECTION=true
LIVE_EMA_TICK_MIN_PRICE_CHANGE=0
LIVE_EMA_SAVE_TEST_FILE=true
LIVE_EMA_OUTPUT_FILE=data/live_ema_cross_results.json
LIVE_EMA_MAX_EVENTS_IN_MEMORY=5000
EMA_CROSS_OUTPUT_FILE=data/ema_cross_results.json

# ============================================================
# OPENING RANGE AND TOUCH PROCESSING
# ============================================================
OPENING_RANGE_ENABLED=true
OPENING_RANGE_INTERVAL=1minute
OPENING_RANGE_CANDLE_COUNT=1
OPENING_RANGE_MARKET_OPEN_HOUR=9
OPENING_RANGE_MARKET_OPEN_MINUTE=15
OPENING_RANGE_FETCH_HOUR=9
OPENING_RANGE_FETCH_MINUTE=18
OPENING_RANGE_INTRADAY_UNIT=minutes
OPENING_RANGE_INTRADAY_INTERVAL=1
OPENING_RANGE_MAX_WORKERS=8
OPENING_RANGE_REQUEST_SLEEP_SECONDS=0.15
OPENING_RANGE_SAVE_FILE=true
OPENING_RANGE_OUTPUT_FILE=data/opening_range_results.json
OPENING_RANGE_MAX_EVENTS_IN_MEMORY=5000
OPENING_RANGE_BACKFILL_TOUCH_SCAN_ENABLED=true
OPENING_RANGE_BACKFILL_TOUCH_SCAN_SOURCE=intraday_api
OPENING_RANGE_TOUCH_ALERT_ENABLED=true
OPENING_RANGE_TOUCH_ALERT_MAX_INSTRUMENTS=5
OPENING_RANGE_TOUCH_ALERT_BATCH_SECONDS=10
OPENING_RANGE_TOUCH_ALERT_ONCE_PER_LEVEL=true
OPENING_RANGE_TOUCH_ALERT_OPTIONS_ONLY=true
OPENING_RANGE_TOUCH_ALERT_SORT_BY_NEAREST_INDEX=true
OPENING_RANGE_TOUCH_ALERT_MAIN_INDEX_KEY=NSE_INDEX|Nifty 50
OPENING_RANGE_BACKFILL_TOUCH_ALERT_ENABLED=true
OPENING_RANGE_LIVE_TOUCH_ALERT_ENABLED=true
OPENING_RANGE_TOUCH_CHECK_MODE=high_low
OPENING_RANGE_STORE_TOUCH_STATUS=true
OPENING_RANGE_TOUCH_EVENTS_OUTPUT_FILE=data/opening_range_touch_events.json
OPENING_RANGE_TOUCH_EVENTS_SAVE_TEST_FILE=true

# ============================================================
# INSTRUMENT ISOLATION
# ============================================================
OPENING_RANGE_ISOLATED_INSTRUMENT_ENABLED=true
OPENING_RANGE_ISOLATION_AVERAGE_WINDOW_POINTS=500
OPENING_RANGE_ISOLATION_MIN_WINDOW_POINTS=0
OPENING_RANGE_ISOLATION_MAX_WINDOW_POINTS=5000
OPENING_RANGE_ISOLATION_TOUCH_LEVELS=R3
OPENING_RANGE_ISOLATION_PRIORITY_LEVELS=R3
OPENING_RANGE_ISOLATED_INSTRUMENT_NOTIFY_ENABLED=true
OPENING_RANGE_ISOLATION_ALLOW_BACKFILL_TOUCH=true
OPENING_RANGE_ISOLATION_ALLOW_LIVE_TOUCH=true
OPENING_RANGE_ISOLATION_OPTIONS_ONLY=true
OPENING_RANGE_ISOLATED_INSTRUMENT_OUTPUT_FILE=data/isolated_opening_range_instrument.json
OPENING_RANGE_ISOLATION_RESET_DAILY=true
OPENING_RANGE_FIRST_TOUCH_SELECTION_ENABLED=true
OPENING_RANGE_FIRST_TOUCH_SELECTION_SOURCE=average_window_level_priority
OPENING_RANGE_SELECTED_OR_TOUCH_NOTIFY_ENABLED=true
OPENING_RANGE_SELECTED_OR_EMA_ALERT_ENABLED=true
OPENING_RANGE_LEGACY_TOUCH_TELEGRAM_ENABLED=false
OPENING_RANGE_SELECTED_OR_EMA_ALERT_ONCE_PER_CROSS=false

# ============================================================
# EMA EVENT ALERTS AND ORDER SUGGESTIONS
# ============================================================
EMA_CROSS_INCLUDE_OPENING_RANGE_LEVELS=true
EMA_CROSS_BROADCAST_WITHOUT_OPENING_RANGE=true
EMA_ISOLATED_INSTRUMENT_TELEGRAM_ENABLED=true
EMA_ISOLATED_ALERT_EVERY_CROSS=true
EMA_ISOLATED_ALERT_INCLUDE_LEVEL_NAME=true
EMA_ISOLATED_ALERT_INCLUDE_NIFTY_LTP=true
EMA_ISOLATED_ALERT_INCLUDE_EMA_DETAILS=true
EMA_ISOLATED_ALERT_INCLUDE_NEAREST_ORDER_INSTRUMENTS=true
EMA_ISOLATED_ALERT_INCLUDE_BUDGET_INSTRUMENTS=true
EMA_ISOLATED_ALERT_INCLUDE_CANDLE_CLOSE=true
EMA_ISOLATED_ALERT_INCLUDE_CANDLE_LOW=true
EMA_ISOLATED_ALERT_INCLUDE_CLOSE_LOW_DIFFERENCE=true
EMA_ISOLATED_ALERT_INCLUDE_CANDLE_TIME=true
EMA_ISOLATED_ALERT_PRICE_DECIMAL_PLACES=2
EMA_ALERT_BULLISH_OPTION_TYPE=CE
EMA_ALERT_BEARISH_OPTION_TYPE=PE
EMA_ALERT_STRIKE_STEP=50
EMA_ALERT_NEAREST_STRIKE_COUNT=3
EMA_ALERT_NEAREST_STRIKE_OFFSETS=-50,0,50
EMA_ALERT_ORDER_STRIKES_CLAMP_TO_FILTER_RANGE=true
EMA_ALERT_INCLUDE_ORDER_INSTRUMENT_LTP=true
EMA_ALERT_SHOW_ORDER_INSTRUMENT_WHEN_LTP_MISSING=true
EMA_ALERT_MAX_ORDER_INSTRUMENTS=3
# EMA automatic order target:
# true  = bullish uses the isolated instrument; bearish uses its matching opposite-side contract
# false = retain existing budget-range order selection logic
EMA_ORDER_USE_ISOLATED_INSTRUMENT=true
EMA_ALERT_BUDGET_RANGE_ENABLED=true
EMA_ALERT_BUDGET_MIN_PRICE=50
EMA_ALERT_BUDGET_MAX_PRICE=120
EMA_ALERT_BUDGET_MAX_INSTRUMENTS=2
EMA_ALERT_BUDGET_USE_SUGGESTED_ORDER_SIDE=true
EMA_ALERT_BUDGET_SUBSCRIBED_ONLY=true
EMA_ALERT_BUDGET_REQUIRE_LIVE_LTP=true
EMA_ALERT_BUDGET_SORT_MODE=nearest_to_budget_midpoint
EMA_ALERT_BUDGET_RANGE_INCLUSIVE=true

# ============================================================
# TELEGRAM (optional; disabled by default)
# ============================================================
# Set TELEGRAM_ENABLED=true only after providing valid credentials.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_RUNTIME_CONFIG_ENABLED=true
TELEGRAM_RUNTIME_CONFIG_CONFIRMATION_REQUIRED=true
TELEGRAM_RUNTIME_CONFIG_CUSTOM_VALUE_ENABLED=true
TELEGRAM_RUNTIME_CONFIG_TIMEOUT_SECONDS=120
TELEGRAM_RUNTIME_CONFIG_SHOW_SENSITIVE_VALUES=false
TELEGRAM_TOKEN_BOT_ENABLED=true
TELEGRAM_TOKEN_BOT_POLL_SECONDS=3
TELEGRAM_TOKEN_BOT_LONG_POLL_TIMEOUT=20
TELEGRAM_TOKEN_BOT_RESTRICT_TO_CHAT=true

# ============================================================
# ALGO APP (optional; disabled by default)
# ============================================================
ALGO_APP_ENABLED=false
ALGO_APP_URL=
ALGO_APP_AUTH_TYPE=none
ALGO_APP_AUTH_TOKEN=
ALGO_APP_API_KEY=
ALGO_APP_API_KEY_HEADER=X-API-Key
ALGO_APP_TIMEOUT_SECONDS=10.0
ALGO_APP_VERIFY_SSL=true
ALGO_APP_MAX_RETRIES=3
ALGO_APP_RETRY_DELAY_SECONDS=2.0
ALGO_APP_SEND_IN_BACKGROUND=true
ALGO_APP_INCLUDE_EVENT_ID=true
ALGO_APP_PAYLOAD_SCHEMA_VERSION=1.0
ALGO_APP_SOURCE_NAME=option_feed_engine
ALGO_APP_MAX_RESPONSE_BODY_LENGTH=2000
ALGO_APP_BACKGROUND_QUEUE_COUNTS_AS_ACCEPTED=true
ALGO_APP_BACKGROUND_MAX_WORKERS=2
ALGO_TELE_APP=true

# EMA payload field selection for Algo App delivery.
EMA_ALGO_PAYLOAD_INCLUDE_OPENING_RANGE=true
EMA_ALGO_PAYLOAD_INCLUDE_EMA_VALUES=true
EMA_ALGO_PAYLOAD_INCLUDE_CANDLE=true
EMA_ALGO_PAYLOAD_INCLUDE_NEAREST_INSTRUMENTS=true
EMA_ALGO_PAYLOAD_INCLUDE_BUDGET_INSTRUMENTS=true
EMA_ALGO_PAYLOAD_INCLUDE_DELIVERY_METADATA=false
EMA_ALGO_PAYLOAD_INCLUDE_NEAREST_INSTRUMENT_CANDLES=true
EMA_ALGO_PAYLOAD_INCLUDE_BUDGET_INSTRUMENT_CANDLES=true
EMA_ALGO_PAYLOAD_INCLUDE_RAW_EMA_EVENT=true

# ============================================================
# EMA ALERT SIMULATION
# ============================================================
EMA_ALERT_SIMULATION_ENABLED=true
EMA_ALERT_SIMULATION_DEFAULT_DRY_RUN=true
EMA_ALERT_SIMULATION_ALLOW_TELEGRAM=false
EMA_ALERT_SIMULATION_ALLOW_ALGO_APP=false

# ============================================================
# CHART PERFORMANCE
# ============================================================
CHART_MAX_BATCH_WORKERS=8

# ============================================================
# DEVELOPMENT / TEST
# ============================================================
TEST_FLAG=false
