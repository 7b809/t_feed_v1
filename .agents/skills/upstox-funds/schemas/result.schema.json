{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstox Funds Result",
  "type": "object",
  "required": ["status", "message", "error", "segments", "raw_response"],
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["success", "error"]},
    "message": {"type": "string"},
    "error": {
      "type": ["object", "null"],
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "segments": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "available_margin": {"type": ["number", "integer", "null"]},
          "used_margin": {"type": ["number", "integer", "null"]},
          "payin_amount": {"type": ["number", "integer", "null"]},
          "span_margin": {"type": ["number", "integer", "null"]},
          "adhoc_margin": {"type": ["number", "integer", "null"]},
          "exposure_margin": {"type": ["number", "integer", "null"]},
          "notional_cash": {"type": ["number", "integer", "null"]}
        },
        "additionalProperties": true
      }
    },
    "raw_response": {"type": ["object", "array", "string", "number", "boolean", "null"]}
  }
}