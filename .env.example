# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=UPSTOX_APP_v3

# ------------------------------------------------------------
# Token source database (read-only)
# The external Telegram/token process writes the access token here.
# ------------------------------------------------------------
TOKEN_MONGODB_DB=UPSTOX_APP
TOKEN_COLLECTION=upstox_tokens
TOKEN_DOCUMENT_ID=upstox_access_token

# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8001
APP_API_KEY=change-me

# ------------------------------------------------------------
# Token refresh schedule
# ------------------------------------------------------------
# Master switch for the scheduled token reload + reconnect.
TOKEN_REFRESH_ENABLED=true

# APScheduler day_of_week expression.
#   "mon-fri" -> Monday through Friday (default)
#   "*"       -> every day
#   "mon,wed,fri" -> specific days
TOKEN_REFRESH_DAY_OF_WEEK=mon-fri

# 24-hour clock, IST by default.
TOKEN_REFRESH_HOUR=8
TOKEN_REFRESH_MINUTE=0

# IANA timezone name used by the cron trigger.
TOKEN_REFRESH_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------
# Startup subscriptions
# Valid modes: ltpc | full | option_greeks | full_d30
# Valid expiry: current_week | next_week | current_month | next_month
#               or an explicit date like 2026-10-30
# ------------------------------------------------------------
STARTUP_INDEX_SUBSCRIPTION_MODE=ltpc
STARTUP_OPTION_SUBSCRIPTION_MODE=ltpc
STARTUP_OPTION_EXPIRY=current_week