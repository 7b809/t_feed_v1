# Copy this file to .env and keep real secrets out of Git.
SUBSCRIPTIONS_API_URL=https://{feed_url}/api/subscriptions
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# Combined ("project") log file — every module's records end up here.
LOG_FILE=logs/app.log

# Per-module log files (one file per Python module that calls get_logger).
MODULE_LOGS_ENABLED=true
MODULE_LOG_DIR=logs/modules

# Historical candle cache (job 2)
DATA_DIR=data
HISTORY_LOOKBACK_DAYS=10
HISTORY_MAX_CONCURRENCY=8

# Intraday candle job (job 3)
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40

# EMA cross job (job 4)
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# Live EMA cross job (job 5)
LIVE_EMA_ENABLED=true
LIVE_EMA_TICK_OFFSET_SECONDS=10
LIVE_EMA_IDLE_SLEEP_SECONDS=30

# Instrument-level logging
INSTRUMENT_ERRORS_ONLY=true

# Live EMA test mode
EMA_TEST_MODE=false

# Live EMA backend selection
USE_LIVE_LTP_FEED=false

# Upstream LTP WebSocket feed.
LIVE_FEED_URL=wss://feed.novag7.in/ws/market
LIVE_FEED_RECONNECT_SECONDS=5
LIVE_FEED_PING_INTERVAL_SECONDS=20
LIVE_FEED_MAX_CONNECTIONS=200

# Bucket interval for LTP-based live EMA, in seconds.
LIVE_EMA_INTERVAL_SECONDS=60

# Daily maintenance refresh (jobs 1 → 4)
DAILY_REFRESH_ENABLED=true
DAILY_REFRESH_TIME=08:40

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Public WebSocket base URL (optional)
# ---------------------------------------------------------------------------
PUBLIC_WS_BASE_URL=

# ---------------------------------------------------------------------------
# Telegram notifications (optional, best-effort)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=""
TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# WebSocket recorder (self-connect for offline replay / analysis)
# ---------------------------------------------------------------------------
WS_RECORDER_ENABLED=false
WS_RECORDER_BASE_URL=
WS_RECORDER_DIR=ws_records
WS_RECORDER_NIFTY_KEY=NSE_INDEX|Nifty 50
WS_RECORDER_RECONNECT_SECONDS=5

# ---------------------------------------------------------------------------
# Bootstrap from MongoDB / MEGA backup
# ---------------------------------------------------------------------------
# On startup, before jobs 1-4, the app tries to seed data/ from the
# MongoDB backup document written by the candle-backup project.
#
# Priority:
#   1. Inline Mongo blob (the `data` field of the blob document) —
#      used whenever present.
#   2. MEGA file link (the `file_link` field of the same document) —
#      used only when the document's `updated_at` / `updated_at_utc`
#      is from today in MARKET_TIMEZONE.
#   3. Fall through to the standard Upstox historical fetch (job 2).
#
# Extraction is incremental by default: existing files on disk are
# left in place, so the bootstrap never clobbers fresher data.
#
#   true  -> bootstrap enabled (default)
#   false -> bootstrap disabled; app always fetches from Upstox
BOOTSTRAP_ENABLED=true

# When true, extracted files overwrite whatever is already on disk.
# Leave false for the safest behaviour.
BOOTSTRAP_OVERWRITE=false

# Mongo connection string for the backup database. Separate from any
# other Mongo URL so the app can be pointed at the backup database
# without coupling to unrelated settings.
BOOTSTRAP_MONGO_URL=

# Database and collection holding the blob document.
BOOTSTRAP_MONGO_DB=UPSTOX_APP_V2
BOOTSTRAP_MONGO_BLOB_COLLECTION=backup_collection
BOOTSTRAP_MONGO_BLOB_DOC_ID=backup_historical_candles

# Server-selection / connect timeout for the bootstrap MongoClient,
# in milliseconds.
BOOTSTRAP_MONGO_TIMEOUT_MS=10000