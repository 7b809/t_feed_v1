{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstox Funds Result",
  "type": "object",
  "required": ["status", "message", "error", "funds", "raw_response"],
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["success", "error"]},
    "message": {"type": "string"},
    "error": {
      "type": ["object", "null"],
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "funds": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "available_to_trade": {
          "type": "object",
          "additionalProperties": true
        },
        "unavailable_to_trade": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "raw_response": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    }
  }
}