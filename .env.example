# ===========================================================================
# MongoDB token storage (required by Telegram token management)
# ===========================================================================
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB=market_data
TOKENS_COLLECTION=auth_tokens
UPSTOX_TOKEN_DOC_ID=upstox_access_token

# ---------------------------------------------------------------------------
# Token validity monitoring
# ---------------------------------------------------------------------------
UPSTOX_TOKEN_CHECK_INTERVAL_MINUTES=30
MARKET_TIMEZONE=Asia/Kolkata
MARKET_TIME_FORMAT=%Y-%m-%d %H:%M:%S %Z

# ===========================================================================
# Telegram token-management bot (optional; set credentials locally)
# ===========================================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<authorized-chat-id>
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_TOKEN_BOT_ENABLED=true
TELEGRAM_TOKEN_BOT_POLL_SECONDS=3
TELEGRAM_TOKEN_BOT_LONG_POLL_TIMEOUT=20
TELEGRAM_TOKEN_BOT_RESTRICT_TO_CHAT=true

# ===========================================================================
# Chart history requests
# ===========================================================================
CHART_MAX_BATCH_WORKERS=8
CHART_LIVE_POLL_SECONDS=30

# ===========================================================================
# Backup extraction (from the candle-backup MongoDB documents)
# ===========================================================================
# These must match the values used by the candle-backup project.
BACKUP_METADATA_COLLECTION=app_tokens
BACKUP_METADATA_DOC_ID=backup_candles
BACKUP_BLOB_COLLECTION=backup_collection
BACKUP_BLOB_DOC_ID=backup_historical_candles

# Where the extracted backup tree lives locally.
LIVE_DATA_DIR=data
# 0 = always re-extract on startup; >0 = skip if the archive is fresh.
BACKUP_MAX_AGE_MINUTES=0

# ===========================================================================
# Upstox live feed (WebSocket)
# ===========================================================================
# Mode: full | ltpc | full_d30 | option_greeks
UPSTOX_WS_MODE=full
UPSTOX_WS_AUTO_START=true
UPSTOX_WS_RECONNECT_INTERVAL=10
# 0 = infinite reconnect attempts
UPSTOX_WS_MAX_RETRIES=0

# ===========================================================================
# Live EMA cross engine
# ===========================================================================
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_ATR_PERIOD=14
EMA_VOLUME_LOOKBACK=20
EMA_SLOPE_LOOKBACK=3
EMA_SEP_ATR_MIN=0.15
EMA_VOLUME_MULT=1.0
EMA_DISTANCE_ATR_MAX=1.5
EMA_MIN_VALIDATION_SCORE=3
EMA_ENABLE_VALIDATION=true

# Filename written inside each instrument folder for today's live crosses.
LIVE_CROSSES_FILENAME=live_crosses.json

# ===========================================================================
# Daily refresh scheduler (Mon–Fri by default)
# ===========================================================================
DAILY_REFRESH_ENABLED=true
DAILY_REFRESH_HOUR=9
DAILY_REFRESH_MINUTE=0
DAILY_REFRESH_DAYS=mon,tue,wed,thu,fri


# ===========================================================================
# Health Feed Log
# ===========================================================================
HEALTH_FEED_LOG=true
HEALTH_FEED_INSTRUMENT="NSE_INDEX|Nifty 50"
HEALTH_FEED_INSTRUMENT_INTERVAL=5


# ===========================================================================
# Index strategy selection (OR-based strike selection per index)
# ===========================================================================
STRATEGY_ENABLED=true
STRATEGY_BASE_DIR=data/strategy

# Buffer mode:
#   typical                -> ATM ± typical_buffer_points (default)
#   typical_plus_minus_avg -> window = typical ± avg across all indices
STRATEGY_BUFFER_MODE=typical

# Optional JSON override for the index list. If unset, the built-in
# defaults (NIFTY 50, BSE SENSEX) are used.
# Example:
# STRATEGY_INDEXES_JSON=[{"index_name":"NIFTY 50","ticker":"NIFTY","instrument_key":"NSE_INDEX|Nifty 50","strike_step":50,"typical_buffer_points":300,"denominator_points":300}]
# STRATEGY_INDEXES_JSON=

# Best-effort Upstox key resolution + historical candle fetch.
STRATEGY_FETCH_HISTORY=true
STRATEGY_HISTORY_DAYS=30
STRATEGY_MAX_WORKERS=6

STRATEGY_ENABLED=true
STRATEGY_BASE_DIR=data/strategy
STRATEGY_STAGE_1_NAME=stage_1_initial
STRATEGY_STAGE_2_NAME=stage_2_isolation
STRATEGY_BUFFER_MODE=typical
STRATEGY_FETCH_HISTORY=true
STRATEGY_HISTORY_DAYS=30
STRATEGY_MAX_WORKERS=6

STRATEGY_ISOLATION_ENABLED=true
STRATEGY_ISOLATION_LOOKBACK_MINUTES=30
STRATEGY_ISOLATION_SKIP_UNRESOLVED=true

STRATEGY_STAGE_3_NAME=stage_3_r2_activated
STRATEGY_STAGE_4_NAME=stage_4_order

STRATEGY_TRACKER_ENABLED=true
STRATEGY_TRACKER_WINDOW_START=09:15
STRATEGY_TRACKER_WINDOW_END=09:20
STRATEGY_TRACKER_POLL_SECONDS=1

STRATEGY_ORDER_ENABLED=true
STRATEGY_ORDER_NIFTY_PICKS=3
STRATEGY_ORDER_SENSEX_PICKS=5
STRATEGY_ORDER_FINAL_PICKS=1
STRATEGY_ORDER_HOUR=9
STRATEGY_ORDER_MINUTE=18
STRATEGY_ORDER_QTY=1

STRATEGY_TRACKER_INDEX_KEYS=NSE_INDEX|Nifty 50,BSE_INDEX|SENSEX

STRATEGY_VERBOSE_LOG=false

# ===========================================================================
# STRATEGY 2 — isolation-level touch + next-cross order (fallback)
# ===========================================================================
# Reuses Stage 1 and Stage 2 of Strategy 1. Only Stage 3 and Stage 4 differ.
STRATEGY_2_ENABLED=true
STRATEGY_2_BASE_DIR=data/strategy2

# Isolation level watched on each Stage-2 isolated contract.
# Allowed: S1, S2, S3, R1, R2, R3. Default S3.
STRATEGY_2_ISOLATION_LEVEL=S3

# Ticker priority: first match wins when multiple contracts touch.
STRATEGY_2_TICKER_PRIORITY=NIFTY,SENSEX

# Stage 3 watcher window (all day by default).
STRATEGY_2_TRACKER_ENABLED=true
STRATEGY_2_TRACKER_WINDOW_START=09:15
STRATEGY_2_TRACKER_WINDOW_END=15:30
STRATEGY_2_TRACKER_POLL_SECONDS=1

# Stage 4 order
STRATEGY_2_ORDER_ENABLED=true
STRATEGY_2_ORDER_QTY=1

# Subfolder names
STRATEGY_2_STAGE_3_NAME=stage_3_isolation_level
STRATEGY_2_STAGE_4_NAME=stage_4_order

# ===========================================================================
# DAILY BACKUP — zip configured folders and save to MongoDB
# ===========================================================================
# Runs at DAILY_BACKUP_HOUR:DAILY_BACKUP_MINUTE every day.
DAILY_BACKUP_ENABLED=true
DAILY_BACKUP_HOUR=16
DAILY_BACKUP_MINUTE=0
DAILY_BACKUP_DAYS=mon,tue,wed,thu,fri,sat,sun

# Folders (relative to the project root) to zip each run.
DAILY_BACKUP_FOLDERS=data

# Destination — deliberately separate from the candle-backup extract doc.
DAILY_BACKUP_MONGO_DB=UPSTOX_APP_V2
DAILY_BACKUP_COLLECTION=backup_collection
DAILY_BACKUP_DOC_ID=market_engine_v1_daily_data_backup

# Inline blob limit (MB). Archives larger than this are saved as
# metadata-only with status = "skipped_size_limit".
DAILY_BACKUP_MAX_BLOB_MB=15

# Value written to the `folder` field in the MongoDB document.
# Defaults to the project directory name.
# DAILY_BACKUP_SOURCE_LABEL=market-engine-v1