# Copy this file to .env and keep real secrets out of Git.
SUBSCRIPTIONS_API_URL=https://{feed_url}/api/subscriptions
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# Combined ("project") log file — every module's records end up here.
LOG_FILE=logs/app.log

# Per-module log files (one file per Python module that calls get_logger).
MODULE_LOGS_ENABLED=true
MODULE_LOG_DIR=logs/modules

# Historical candle cache (job 2)
DATA_DIR=data
HISTORY_LOOKBACK_DAYS=10
HISTORY_MAX_CONCURRENCY=8

# Intraday candle job (job 3)
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40

# EMA cross job (job 4)
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# Live EMA cross job (job 5)
LIVE_EMA_ENABLED=true
LIVE_EMA_TICK_OFFSET_SECONDS=10
LIVE_EMA_IDLE_SLEEP_SECONDS=30

# Instrument-level logging
# When true, only errors that occur while processing an instrument are
# logged. Per-instrument success/progress lines are suppressed. Job-level
# summaries and startup/shutdown logs are unaffected.
INSTRUMENT_ERRORS_ONLY=true

# Live EMA test mode
# When true, the REST-based live EMA job ignores the market-hours window
# and fires every minute (24x7). Not used when USE_LIVE_LTP_FEED=true.
EMA_TEST_MODE=false

# Live EMA backend selection
#   true  -> live EMA is computed from the upstream LTP WebSocket feed,
#            aggregated into fixed-interval buckets. This is the default.
#   false -> live EMA is computed by polling the intraday REST endpoint
#            once per minute (the original job 5).
USE_LIVE_LTP_FEED=false

# Upstream LTP WebSocket feed.
#   URL template: {LIVE_FEED_URL}?instrument_key={url-encoded instrument_key}
#   The upstream itself suppresses data outside market hours / on holidays.
LIVE_FEED_URL=wss://feed.novag7.in/ws/market
LIVE_FEED_RECONNECT_SECONDS=5
LIVE_FEED_PING_INTERVAL_SECONDS=20
# Cap on concurrent upstream connections. 0 disables the cap.
LIVE_FEED_MAX_CONNECTIONS=200

# Bucket interval for LTP-based live EMA, in seconds.
#   60  -> 1-minute completed candles (default)
#   300 -> 5-minute completed candles
# Alerts are only ever emitted when a bucket closes; partial candles never
# produce an EMA cross.
LIVE_EMA_INTERVAL_SECONDS=60

# Daily maintenance refresh (jobs 1 → 4)
#   Runs once per market day (Mon–Fri) at DAILY_REFRESH_TIME, in
#   MARKET_TIMEZONE. Job 5 (live EMA) keeps running in the background.
#   Weekends are always skipped, regardless of this flag.
DAILY_REFRESH_ENABLED=true
DAILY_REFRESH_TIME=08:40

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins.
#   "*"                 -> allow every origin (no credentials)
#   "https://a.com,..." -> explicit allow-list
#
# When CORS_ALLOWED_ORIGINS is "*", CORS_ALLOW_CREDENTIALS is ignored
# because credentials are incompatible with a wildcard origin per the
# CORS spec — Starlette falls back to echoing the request Origin.
CORS_ALLOWED_ORIGINS=*

# Only honoured when CORS_ALLOWED_ORIGINS is NOT "*".
# Required for cookie-based auth; leave false for token auth.
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Public WebSocket base URL (optional)
# ---------------------------------------------------------------------------
# Used by /api/instruments, /api/hard-refresh, and /api/ws-samples to build
# per-instrument `connect_url` values that point at our live-EMA WebSocket.
#
#   ""  (default)          -> derive from request scheme/host, honouring
#                             X-Forwarded-Proto and X-Forwarded-Host.
#   "wss://feed.novag7.in" -> hard-code a public base URL. Useful when the
#                             app sits behind a reverse proxy and the
#                             backend does not see the external hostname.
PUBLIC_WS_BASE_URL=

# ---------------------------------------------------------------------------
# Telegram notifications (optional, best-effort)
# ---------------------------------------------------------------------------
# Sends formatted startup/shutdown messages to a Telegram chat via the Bot
# HTTP API. No Telegram package is required — only `requests`, which is
# already a project dependency.
#
#   true  -> send formatted startup/shutdown messages to TELEGRAM_CHAT_ID
#   false -> notifications disabled entirely
TELEGRAM_ENABLED=false

# Bot token from @BotFather (e.g. 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Target chat id. Accepts numeric user ids, negative group ids, or a channel
# handle like "@mychannel". Surrounding quotes are tolerated and stripped.
TELEGRAM_CHAT_ID=""

# Per-request timeout for the Telegram API, in seconds.
TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# WebSocket recorder (self-connect for offline replay / analysis)
# ---------------------------------------------------------------------------
# When true, a background service opens one WebSocket connection to our own
# live-EMA endpoint for the Nifty 50 index, waits for the first tick, then
# opens a second connection to a randomly chosen instrument whose strike is
# nearest to Nifty 50's LTP. Every frame received is appended as a single
# JSON line to a per-session .jsonl file under WS_RECORDER_DIR.
#
# NOTE: the recorder is a WS *client* of our own server. It therefore only
# sees live data when the live EMA backend is active — i.e. when
# USE_LIVE_LTP_FEED=true and LIVE_EMA_ENABLED=true.
#
#   true  -> recorder enabled
#   false -> recorder disabled (default)
WS_RECORDER_ENABLED=false

# Base URL of our own server (the recorder connects to this).
# Empty -> PUBLIC_WS_BASE_URL, then ws://127.0.0.1:8002.
WS_RECORDER_BASE_URL=

# Root folder for recorded files.
#   <dir>/<safe_instrument_key>/<YYYYMMDD_HHMMSS>.jsonl
WS_RECORDER_DIR=ws_records

# Index instrument to record first (the reference "spot").
# Pipe is fine — the recorder URL-encodes it when opening the socket.
WS_RECORDER_NIFTY_KEY=NSE_INDEX|Nifty 50

# Reconnect backoff for the recorder's client connections, seconds.
WS_RECORDER_RECONNECT_SECONDS=5