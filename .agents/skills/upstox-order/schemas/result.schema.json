{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "submitted"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PREVIEW", "SUCCESS", "API_ERROR", "UNSUPPORTED", "ERROR"]
    },
    "submitted": {"type": "boolean"},
    "order": {"type": ["object", "null"]},
    "instrument_metadata": {"type": "object"},
    "price_source": {"type": "string"},
    "reference_ltp": {"type": ["number", "null"]},
    "quantity_source": {"type": "string"},
    "preview_hash": {"type": "string"},
    "market_quote": {},
    "api_response": {},
    "http_status": {"type": ["integer", "null"]},
    "error": {"type": "object"},
    "message": {"type": "string"}
  },
  "additionalProperties": true
}
