# Upstox order service — sandbox_v1

# MongoDB token source and order persistence
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=UPSTOX_APP_V2
APP_TOKENS_COLLECTION=app_tokens
TOKEN_DOC_ID=upstox_access_token
ORDERS_COLLECTION=sandbox_orders

# Keep sandbox=true and trading_enabled=false while testing.
UPSTOX_SANDBOX=true
TRADING_ENABLED=false
UPSTOX_API_VERSION=2.0

# External server-to-server trading API authentication.
# Leave disabled for unauthenticated external endpoints. When enabled, both
# tokens must be different or independently generated 32-character secrets.
EXTERNAL_API_AUTH_ENABLED=false
EXTERNAL_API_SOURCE_TOKEN=
EXTERNAL_API_DESTINATION_TOKEN=

# Requested order defaults: BUY, 65 units, MARKET, Intraday.
DEFAULT_ORDER_QUANTITY=65
DEFAULT_TRANSACTION_TYPE=BUY
DEFAULT_PRODUCT=I
DEFAULT_ORDER_TYPE=MARKET
DEFAULT_VALIDITY=DAY

# Telegram event notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily MEGA backup: archives the complete data/ folder, including daily order JSON ledgers.
# Staging must remain outside DATA_DIR. Runs weekdays at 16:05 Asia/Kolkata by default.
APP_NAME=sandbox_v1
DATA_DIR=./data
DAILY_DATA_BACKUP_ENABLED=true
DAILY_DATA_BACKUP_DIR=./backups
DAILY_DATA_BACKUP_HOUR=16
DAILY_DATA_BACKUP_MINUTE=5
DAILY_DATA_BACKUP_DAYS=mon-fri
DAILY_DATA_BACKUP_COLLECTION=daily_data_backup_state

MEGA_ENABLED=true
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_BACKUP_ROOT=sandbox_v1

# Service binding
API_PORT=8004
ENABLE_IP_BINDING=false
BIND_IP=127.0.0.1

# Runtime data and logs
LOGS_DIR=logs
LOGS_TEXT_DIR=logs_text
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Upstox instrument search HTTP client and local fallback cache.
# Use an honest app identifier; do not impersonate a browser.
UPSTOX_USER_AGENT=sandbox_v1/1.0 (Upstox instrument-search integration)
UPSTOX_HTTP_TIMEOUT_SECONDS=12
UPSTOX_INSTRUMENT_CACHE_ENABLED=true
UPSTOX_INSTRUMENT_CACHE_MAX_STALE_SECONDS=604800
