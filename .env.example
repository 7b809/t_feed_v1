# ============================================================
# ISOLATED INSTRUMENT EVENT
# ============================================================
# Enable/disable isolated instrument event processing
ISOLATED_INSTRUMENT_EVENT_ENABLED=true

# MongoDB collection name for isolated instrument events
ISOLATED_INSTRUMENT_EVENT_COLLECTION=isolated_instrumentevent


# ============================================================
# TELEGRAM NOTIFICATIONS
# ============================================================
# Master switch to enable/disable all Telegram notifications
TELEGRAM_ENABLED="true"

# Telegram bot token (get from @BotFather) - DUMMY VALUE
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz-1234567"

# Telegram bot token used for testing (separate from production) - DUMMY VALUE
TELEGRAM_BOT_TEST_TOKEN="9876543210:ZYXwvuTSRqponMLKjihgfeDCBA-7654321"

# Telegram chat/group ID where alerts are sent - DUMMY VALUE
TELEGRAM_CHAT_ID="-1001234567890"

# Timeout (seconds) for Telegram API calls
TELEGRAM_TIMEOUT_SECONDS="10"


# ============================================================
# UPSTOX ORDER EXECUTION
# ============================================================
# Enable/disable Upstox order placement
UPSTOX_ORDER_ENABLED=true

# If true, actually places orders; if false, runs in dry-run mode
PLACE_ORDER=true

# MongoDB collection name for Upstox orders
UPSTOX_ORDER_COLLECTION=upstox_orders

# Upstox API mode: "full" = live trading, "sandbox" = paper trading
UPSTOX_MODE="full"

# MongoDB collection for Upstox access tokens
TOKENS_COLLECTION="upstox_tokens"


# ============================================================
# ALGO APP (External Order Request Service)
# ============================================================
# Master switch to enable/disable the algo app integration
ALGO_APP_ENABLED="false"

# Print detailed logs to console
PRINT_LOGS=true

# Maximum retry attempts for failed algo app calls
ALGO_APP_MAX_RETRIES="3"

# Delay (seconds) between retries
ALGO_APP_RETRY_DELAY_SECONDS="2"

# Send algo app requests in background thread (non-blocking)
ALGO_APP_SEND_IN_BACKGROUND="true"

# HTTP timeout (seconds) for algo app requests
ALGO_APP_TIMEOUT_SECONDS="10"

# Algo app API endpoint URL - DUMMY VALUE
ALGO_APP_URL="http://13.205.170.171:8000/api/v1/order-requests"
# ALGO_APP_URL=http://127.0.0.1:8001/api/v1/order-requests

# Verify SSL certificate for algo app (set false for self-signed certs)
ALGO_APP_VERIFY_SSL="false"

# Enable/disable Telegram integration with algo app
ALGO_TELE_APP="True"


# ============================================================
# CANDLE & MARKET TIMING
# ============================================================
# Candle intervals (minutes) to process - comma separated
CANDLE_INTERVALS="1,3,5"

# Time to refresh daily data (HH:MM in IST)
DAILY_REFRESH_TIME="08:40"

# Live candle interval (minutes)
LIVE_CANDLE_INTERVAL="1"

# Market open time (HH:MM in IST)
MARKET_OPEN_TIME="09:15"

# Market close time (HH:MM in IST)
MARKET_CLOSE_TIME="15:40"

# WebSocket connection time (HH:MM in IST)
WEBSOCKET_CONNECT_TIME="09:10"

# Number of historical days to fetch
HISTORICAL_DAYS="7"


# ============================================================
# EMA (Exponential Moving Average) SETTINGS
# ============================================================
# Short EMA period
EMA_SHORT_PERIOD="9"

# Long EMA period
EMA_LONG_PERIOD="21"

# Maximum number of crossover events to store
MAX_CROSSOVER_EVENTS="500"


# ============================================================
# EMA ALERT BUDGET FILTER
# ============================================================
# Max number of instruments to alert on (budget cap)
EMA_ALERT_BUDGET_MAX_INSTRUMENTS="3"

# Max option premium price to consider
EMA_ALERT_BUDGET_MAX_PRICE="120.0"

# Min option premium price to consider
EMA_ALERT_BUDGET_MIN_PRICE="50.0"

# Enable price range filtering
EMA_ALERT_BUDGET_RANGE_ENABLED="true"

# Sort mode for selecting instruments
# Options: "nearest_to_budget_midpoint", "cheapest", "most_expensive"
EMA_ALERT_BUDGET_SORT_MODE="nearest_to_budget_midpoint"

# Only consider instruments user is subscribed to
EMA_ALERT_BUDGET_SUBSCRIBED_ONLY="true"

# Use suggested order side (BUY/SELL) from signal
EMA_ALERT_BUDGET_USE_SUGGESTED_ORDER_SIDE="true"


# ============================================================
# EMA ALERT SIMULATION
# ============================================================
# Enable simulation mode for EMA alerts
EMA_ALERT_SIMULATION_ENABLED=true

# Default to dry-run (no real orders) in simulation
EMA_ALERT_SIMULATION_DEFAULT_DRY_RUN=true

# Allow Telegram notifications during simulation
EMA_ALERT_SIMULATION_ALLOW_TELEGRAM=true

# Allow algo app order requests during simulation
EMA_ALERT_SIMULATION_ALLOW_ALGO_APP=true


# ============================================================
# OPENING RANGE ISOLATION
# ============================================================
# Priority levels to isolate (comma separated) - e.g. R1,R2,R3
OPENING_RANGE_ISOLATION_PRIORITY_LEVELS="R3"

# Average window points for opening range isolation
OPENING_RANGE_ISOLATION_AVERAGE_WINDOW_POINTS="300.0"

# Max window points for opening range isolation
OPENING_RANGE_ISOLATION_MAX_WINDOW_POINTS="5000.0"

# Min window points for opening range isolation
OPENING_RANGE_ISOLATION_MIN_WINDOW_POINTS="0.0"

# Reset opening range data daily
OPENING_RANGE_ISOLATION_RESET_DAILY="true"


# ============================================================
# OPTION INSTRUMENT / STRIKE SELECTION
# ============================================================
# Underlying index instrument key - DUMMY VALUE
OPTION_INSTRUMENT_KEY="NSE_INDEX|Nifty 50"

# Strike range start (lower bound)
STRIKE_FROM="23000"

# Strike range end (upper bound)
STRIKE_TO="25000"

# Save options data to disk (true/false)
SAVE_OPTIONS_DATA="false"


# ============================================================
# MONGODB
# ============================================================
# MongoDB connection string - DUMMY VALUE
MONGO_URL="mongodb://username:password@localhost:27017/?authSource=admin"

# MongoDB database name
MONGO_DB="UPSTOX_APP"

# MongoDB collection for order requests
MONGO_ORDERS_COLL="orders_reqs"


# ============================================================
# RUNTIME CONFIG (Hot-reloadable settings stored in DB)
# ============================================================
# Enable runtime config system
RUNTIME_CONFIG_ENABLED="true"

# MongoDB collection for runtime configs
RUNTIME_CONFIG_COLLECTION="runtime_configs"

# Enable caching of runtime configs
RUNTIME_CONFIG_CACHE_ENABLED="true"

# If true, fall back to defaults on config load failure
RUNTIME_CONFIG_FAIL_OPEN="true"

# Enable audit logging of config changes
RUNTIME_CONFIG_AUDIT_ENABLED="true"

# MongoDB collection for config audit trail
RUNTIME_CONFIG_AUDIT_COLLECTION="runtime_config_audit"

# Max audit records to retain
RUNTIME_CONFIG_MAX_AUDIT_RECORDS="5000"


# ============================================================
# TELEGRAM RUNTIME CONFIG (Control config via Telegram bot)
# ============================================================
# Enable Telegram-based runtime config editing
TELEGRAM_RUNTIME_CONFIG_ENABLED="true"

# Require confirmation before applying config changes
TELEGRAM_RUNTIME_CONFIG_CONFIRMATION_REQUIRED="true"

# Allow custom values (not just predefined options)
TELEGRAM_RUNTIME_CONFIG_CUSTOM_VALUE_ENABLED="true"

# Show sensitive values (tokens, passwords) in Telegram
TELEGRAM_RUNTIME_CONFIG_SHOW_SENSITIVE_VALUES="false"

# Timeout (seconds) for config confirmation prompt
TELEGRAM_RUNTIME_CONFIG_TIMEOUT_SECONDS="120"


# ============================================================
# SERVER / HOST
# ============================================================
# Host to bind the server to (0.0.0.0 = all interfaces)
HOST="0.0.0.0"

# Port to bind the server to
PORT="8000"


# ============================================================
# LOGGING
# ============================================================
# Directory to store log files
LOG_DIR="logs"

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"


# ============================================================
# DATA / TICK STORAGE
# ============================================================
# File path for tick data (JSONL format)
TICK_FILE="data/ticks.jsonl"